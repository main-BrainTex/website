---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { FAQ_GROUPS, FAQS, type FaqGroup } from '../data/faq';
import { href, UI, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  it: {
    title: 'Domande frequenti su BrainTex',
    description:
      'Risposte alle domande più comuni su BrainTex: come funziona, su quali macchine si usa, installazione, assistenza, dati e collaborazioni.',
    eyebrow: 'Domande frequenti',
    h1: 'Le risposte alle domande che ci fanno più spesso.',
    lead: 'Non trovi quello che cerchi? Scrivici: ti risponde una persona del team.',
    more: 'Approfondisci',
    ctaTitle: 'Hai un’altra domanda?',
    ctaText: 'Raccontaci la tua produzione o il tuo progetto: ti rispondiamo noi.',
    ctaButton: 'Scrivici',
  },
  en: {
    title: 'BrainTex FAQ',
    description:
      'Answers to the most common questions about BrainTex: how it works, which machines it fits, installation, support, data and partnerships.',
    eyebrow: 'FAQ',
    h1: 'Answers to the questions we hear most often.',
    lead: 'Can’t find what you are looking for? Write to us: a person from the team will reply.',
    more: 'Find out more',
    ctaTitle: 'Do you have another question?',
    ctaText: 'Tell us about your production or your project: we will get back to you.',
    ctaButton: 'Write to us',
  },
}[lang];

const groups = Object.keys(FAQ_GROUPS) as FaqGroup[];

// Dati strutturati FAQPage per i motori di ricerca.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({
    '@type': 'Question',
    name: f.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: f.a[lang] },
  })),
};
---

<Base lang={lang} routeKey="faq" title={t.title} description={t.description} jsonLd={jsonLd}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="wrap faq">
      {
        groups.map((g) => (
          <div class="faq__group">
            <h2>{FAQ_GROUPS[g][lang]}</h2>
            {FAQS.filter((f) => f.group === g).map((f) => (
              <details class="faq__item" id={f.id}>
                <summary>{f.q[lang]}</summary>
                <div class="faq__answer">
                  <p>{f.a[lang]}</p>
                  {f.link && (
                    <a href={href(f.link, lang)}>
                      {t.more}: {UI[lang].nav[f.link as keyof (typeof UI)['it']['nav']] ?? ''}
                    </a>
                  )}
                </div>
              </details>
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand title={t.ctaTitle} text={t.ctaText} button={t.ctaButton} link={href('contact', lang)} />
</Base>

<style>
  .faq {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    max-width: 52rem;
  }

  .faq__group h2 {
    margin-bottom: 1rem;
    font-size: 1.4rem;
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary::after {
    content: '+';
    color: var(--accent);
    font-size: 1.3rem;
    line-height: 1;
  }

  .faq__item[open] summary::after {
    content: '−';
  }

  .faq__item summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .faq__answer {
    padding-bottom: 1.25rem;
  }

  .faq__answer p {
    margin: 0 0 0.6rem;
    color: var(--text-muted);
  }

  .faq__answer a {
    font-weight: 700;
  }
</style>
