---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../config';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  it: {
    title: 'Contatti',
    description:
      'Contatta BrainTex: informazioni sul prodotto, candidature, investitori, partner e stampa. Sede operativa a Biella, nel distretto tessile.',
    eyebrow: 'Contatti',
    h1: 'Parliamone.',
    lead: 'Informazioni sul prodotto, candidature, collaborazioni o richieste dalla stampa: scrivici e ti rispondiamo noi.',
    formTitle: 'Scrivici',
    whereTitle: 'Dove siamo',
    legalSeat: 'Sede legale',
    operationalSeat: 'Sede operativa',
    district: 'nel distretto tessile',
    social: 'Seguici',
  },
  en: {
    title: 'Contact',
    description:
      'Contact BrainTex: product information, applications, investors, partners and press. Operational site in Biella, in the textile district.',
    eyebrow: 'Contact',
    h1: 'Let’s talk.',
    lead: 'Product information, applications, partnerships or press enquiries: write to us and we will get back to you.',
    formTitle: 'Write to us',
    whereTitle: 'Where we are',
    legalSeat: 'Registered office',
    operationalSeat: 'Operational site',
    district: 'in the textile district',
    social: 'Follow us',
  },
}[lang];
---

<Base lang={lang} routeKey="contact" title={t.title} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="wrap contact">
      <div>
        <h2 class="contact__h">{t.formTitle}</h2>
        <ContactForm lang={lang} />
      </div>
      <aside class="contact__aside">
        <h2 class="contact__h">{t.whereTitle}</h2>
        <dl>
          <dt>{t.legalSeat}</dt>
          <dd>{SITE.legalSeat}</dd>
          <dt>{t.operationalSeat}</dt>
          <dd>{SITE.operationalSeat}, {t.district}</dd>
          <dt>{t.social}</dt>
          <dd><a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a></dd>
        </dl>
      </aside>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
  }

  @media (max-width: 56rem) {
    .contact {
      grid-template-columns: 1fr;
    }
  }

  .contact__h {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .contact__aside dl {
    margin: 0;
  }

  .contact__aside dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .contact__aside dd {
    margin: 0.25rem 0 1.5rem;
    font-size: 1.1rem;
  }
</style>
