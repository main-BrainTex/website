---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { STATS } from '../config';
import { href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const contact = href('contact', lang);
const millions = Math.floor(STATS.metersInspected / 1_000_000);

const t = {
  it: {
    title: 'Investitori e partner',
    description:
      'BrainTex per investitori e partner: dalla visione artificiale per il controllo qualità alla fabbrica intelligente. Costruttori di macchine, software house ERP e MES, confezionisti, università e fornitori.',
    eyebrow: 'Investitori e partner',
    h1: 'Costruiamo insieme il controllo qualità del futuro.',
    lead: 'Partiamo dal tessile, dove il controllo a vista è ancora la norma. La stessa tecnologia può portare valore ovunque un materiale scorra in rotoli.',
    investors: {
      eyebrow: 'Investitori',
      title: 'Il controllo qualità è solo l’inizio.',
      text: [
        'La visione artificiale applicata al controllo qualità è la tecnologia abilitante: ci porta dentro le macchine, ogni giorno, su ogni metro di tessuto.',
        'La nostra visione è la fabbrica intelligente: sistemi interconnessi che generano dati, li trasformano in insight e permettono decisioni basate sui fatti, lungo tutta la filiera. Partiamo dal tessile, ma la stessa tecnologia può crescere ovunque un materiale venga prodotto e controllato in continuo.',
      ],
      pathTitle: 'Dove stiamo andando',
      path: [
        { step: 'Oggi', title: 'Vedere', text: 'Ogni difetto, su ogni metro, in tempo reale, sulle macchine che l’azienda ha già.' },
        { step: 'Domani', title: 'Collegare', text: 'Le fasi della filiera si parlano: tessitura, finissaggio, controllo, confezione, gestionali.' },
        { step: 'La visione', title: 'Decidere', text: 'Una fabbrica intelligente in cui i dati diventano insight e le decisioni si prendono sui fatti.' },
      ],
      whyTitle: 'Perché adesso, perché noi',
      why: [
        { title: 'Già al lavoro in produzione', text: `Oltre ${millions} milioni di metri di tessuto ispezionati in aziende vere, non in laboratorio.` },
        { title: 'Tecnologia protetta', text: 'Domanda di brevetto depositata e modelli addestrati sul tessuto di ogni singolo cliente.' },
        { title: 'Dati che valgono sempre di più', text: 'Ogni pezza ispezionata aggiunge informazioni: il valore del sistema cresce con l’uso.' },
        { title: 'Il vento della normativa', text: 'Con il passaporto digitale di prodotto (ESPR) i dati di filiera contano sempre di più. Quelli di BrainTex sono dati utili anche per questo.' },
        { title: 'Riconosciuti dall’ecosistema', text: 'Forbes Under 30 2026, Premio Nazionale per l’Innovazione 2025 (Top 4 Industrial e Premio Venture CDP), Start Up Now 2025.' },
        { title: 'Nati al Politecnico, cresciuti nel distretto', text: 'Incubati in I3P, l’incubatore del Politecnico di Torino, con la sede operativa a Biella, nel cuore del tessile.' },
      ],
      ctaText: 'Il resto te lo raccontiamo di persona: numeri, piani e prossimi passi.',
      ctaDeck: 'Richiedi la presentazione',
      ctaCall: 'Fissiamo una call',
    },
    blocks: [
      {
        id: 'partner',
        eyebrow: 'Costruttori di macchine e integratori',
        title: 'Il controllo qualità, dentro la tua macchina.',
        text: [
          'BrainTex è pensato per montarsi su macchinari esistenti. Se costruisci o integri macchine per il tessile, possiamo portare insieme l’ispezione automatica ai tuoi clienti.',
        ],
        audience: 'partner',
        cta: 'Proponi una collaborazione',
      },
      {
        id: 'software',
        eyebrow: 'IT provider e software house',
        title: 'I dati della qualità, dentro ERP e MES.',
        text: [
          'Ogni pezza ispezionata produce dati: difetti, posizioni, metri, classificazioni. Valgono molto di più quando entrano nei sistemi con cui l’azienda già lavora.',
          'Se sviluppi o installi gestionali, MES o software di pianificazione per il tessile, lavoriamo insieme: i tuoi clienti ritrovano la qualità accanto a ordini, lotti e commesse.',
        ],
        audience: 'it',
        cta: 'Parliamo di integrazione',
      },
      {
        id: 'confezionisti',
        eyebrow: 'Confezionisti e brand',
        title: 'Uno standard di qualità lungo tutta la filiera.',
        text: [
          'La filiera tessile è fatta di tante aziende, spesso conto terzi. Chi confeziona riceve il tessuto alla fine e paga i difetti che nessuno ha visto prima.',
          'Puoi invitare i tuoi fornitori ad adottare lo stesso controllo: ogni pezza arriva con la sua mappa dei difetti, utile per il taglio, e con dati confrontabili da un fornitore all’altro.',
        ],
        audience: 'confezionista',
        cta: 'Porta lo standard in filiera',
      },
      {
        id: 'istituzioni',
        eyebrow: 'Università, istituzioni e bandi',
        title: 'Ricerca applicata, con i piedi in fabbrica.',
        text: [
          'Nati dall’Academy di I3P e incubati al Politecnico di Torino, collaboriamo volentieri a progetti di ricerca, bandi e iniziative per l’innovazione del settore.',
        ],
        audience: 'partner',
        cta: 'Scrivici',
      },
      {
        id: 'progetti',
        eyebrow: 'Proponi un progetto',
        title: 'Un bando, un co-sviluppo, una ricerca?',
        text: [
          'Se hai in mente un progetto in cui BrainTex può portare valore, dalla partecipazione a un bando allo sviluppo condiviso di una soluzione, raccontacelo.',
          'Valutiamo ogni proposta in linea con la nostra visione. Per i bandi indicaci la scadenza: così capiamo subito se c’è il tempo per lavorarci bene.',
        ],
        audience: 'progetto',
        cta: 'Proponi un progetto',
      },
      {
        id: 'fornitori',
        eyebrow: 'Fornitori',
        title: 'Hai un prodotto o un servizio da proporci?',
        text: [
          'Valutiamo volentieri nuove proposte di fornitura. Per risponderti in fretta ci servono subito alcune informazioni: cosa proponi, in quale categoria rientra e dove trovare schede o catalogo.',
          'Usa il modulo scegliendo “Fornitore”: le proposte arrivano tutte nello stesso posto e le leggiamo con calma.',
        ],
        audience: 'fornitore',
        cta: 'Invia una proposta di fornitura',
      },
    ],
  },
  en: {
    title: 'Investors & partners',
    description:
      'BrainTex for investors and partners: from machine vision for quality control to the smart factory. Machine builders, ERP and MES software houses, garment makers, universities and suppliers.',
    eyebrow: 'Investors & partners',
    h1: 'Let’s build the future of quality control together.',
    lead: 'We start from textiles, where visual inspection is still the norm. The same technology can add value wherever material runs in rolls.',
    investors: {
      eyebrow: 'Investors',
      title: 'Quality control is only the beginning.',
      text: [
        'Machine vision applied to quality control is the enabling technology: it takes us inside the machines, every day, on every metre of fabric.',
        'Our vision is the smart factory: interconnected systems that generate data, turn it into insight and enable fact-based decisions across the whole supply chain. We start from textiles, but the same technology can grow wherever material is produced and inspected continuously.',
      ],
      pathTitle: 'Where we are heading',
      path: [
        { step: 'Today', title: 'See', text: 'Every defect, on every metre, in real time, on the machines a company already has.' },
        { step: 'Next', title: 'Connect', text: 'The stages of the supply chain talk to each other: weaving, finishing, inspection, garment making, management systems.' },
        { step: 'The vision', title: 'Decide', text: 'A smart factory where data becomes insight and decisions are based on facts.' },
      ],
      whyTitle: 'Why now, why us',
      why: [
        { title: 'Already at work in production', text: `Over ${millions} million metres of fabric inspected in real companies, not in a lab.` },
        { title: 'Protected technology', text: 'A filed patent application and models trained on each customer’s own fabric.' },
        { title: 'Data that keeps gaining value', text: 'Every inspected piece adds information: the value of the system grows with use.' },
        { title: 'Regulation is moving towards data', text: 'With the Digital Product Passport (ESPR), supply chain data matters more and more. BrainTex data is useful for this too.' },
        { title: 'Recognised by the ecosystem', text: 'Forbes Under 30 2026, National Innovation Award 2025 (Top 4 Industrial and CDP Venture Award), Start Up Now 2025.' },
        { title: 'Born at the Politecnico, grown in the district', text: 'Incubated at I3P, the Politecnico di Torino incubator, with our operational site in Biella, at the heart of textiles.' },
      ],
      ctaText: 'We will tell you the rest in person: figures, plans and next steps.',
      ctaDeck: 'Request the presentation',
      ctaCall: 'Let’s book a call',
    },
    blocks: [
      {
        id: 'partner',
        eyebrow: 'Machine builders & integrators',
        title: 'Quality control, built into your machine.',
        text: [
          'BrainTex is designed to be mounted on existing machines. If you build or integrate textile machinery, together we can bring automated inspection to your customers.',
        ],
        audience: 'partner',
        cta: 'Propose a partnership',
      },
      {
        id: 'software',
        eyebrow: 'IT providers & software houses',
        title: 'Quality data, inside ERP and MES.',
        text: [
          'Every inspected piece generates data: defects, positions, metres, classifications. They are worth much more once they reach the systems the company already works with.',
          'If you develop or deploy ERP, MES or planning software for textiles, let’s work together: your customers find quality next to orders, lots and jobs.',
        ],
        audience: 'it',
        cta: 'Let’s talk integration',
      },
      {
        id: 'confezionisti',
        eyebrow: 'Garment makers & brands',
        title: 'One quality standard across the supply chain.',
        text: [
          'The textile supply chain is made of many companies, often subcontractors. Garment makers receive the fabric last and pay for the defects nobody saw earlier.',
          'You can invite your suppliers to adopt the same inspection: each piece arrives with its defect map, useful for cutting, and with data you can compare across suppliers.',
        ],
        audience: 'confezionista',
        cta: 'Bring the standard to your supply chain',
      },
      {
        id: 'istituzioni',
        eyebrow: 'Universities, institutions & funding',
        title: 'Applied research, with feet on the factory floor.',
        text: [
          'Born from the I3P Academy and incubated at Politecnico di Torino, we are glad to take part in research projects, calls and initiatives for innovation in the sector.',
        ],
        audience: 'partner',
        cta: 'Write to us',
      },
      {
        id: 'progetti',
        eyebrow: 'Propose a project',
        title: 'A funding call, a co-development, a research project?',
        text: [
          'If you have a project where BrainTex can add value, from joining a funding call to jointly developing a solution, tell us about it.',
          'We assess every proposal that fits our vision. For funding calls, let us know the deadline: that way we can tell right away whether there is time to do it well.',
        ],
        audience: 'progetto',
        cta: 'Propose a project',
      },
      {
        id: 'fornitori',
        eyebrow: 'Suppliers',
        title: 'Do you have a product or service to offer us?',
        text: [
          'We are glad to evaluate new supply proposals. To reply quickly we need a few details up front: what you offer, which category it falls into and where to find datasheets or a catalogue.',
          'Use the form choosing “Supplier”: all proposals land in the same place and we read them carefully.',
        ],
        audience: 'fornitore',
        cta: 'Send a supply proposal',
      },
    ],
  },
}[lang];
---

<Base lang={lang} routeKey="investors" title={t.title} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section id="investitori" class="section">
    <div class="wrap">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">{t.investors.eyebrow}</p>
          <h2>{t.investors.title}</h2>
        </div>
        <div data-reveal="1">
          {t.investors.text.map((p) => <p class="lead">{p}</p>)}
        </div>
      </div>

      <h3 class="inv__h">{t.investors.pathTitle}</h3>
      <ol class="path plain">
        {
          t.investors.path.map((p, i) => (
            <li class="card path__step" data-reveal={String(i + 1)}>
              <span class="path__when">{p.step}</span>
              <strong class="path__what">{p.title}</strong>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="inv__h">{t.investors.whyTitle}</h3>
      <ul class="grid grid--3 plain">
        {
          t.investors.why.map((w, i) => (
            <li class="card" data-reveal={String((i % 3) + 1)}>
              <h4>{w.title}</h4>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="inv__cta" data-reveal>
        <p class="lead">{t.investors.ctaText}</p>
        <div class="actions">
          <a class="btn" href={`${contact}?chi=investitore&tema=presentazione`}>{t.investors.ctaDeck}</a>
          <a class="btn btn--ghost" href={`${contact}?chi=investitore&tema=call`}>{t.investors.ctaCall}</a>
        </div>
      </div>
    </div>
  </section>

  {
    t.blocks.map((b, i) => (
      <section id={b.id} class:list={['section', { 'section--raised': i % 2 === 0 }]}>
        <div class="wrap split">
          <div data-reveal>
            <p class="eyebrow">{b.eyebrow}</p>
            <h2>{b.title}</h2>
          </div>
          <div data-reveal="1">
            {b.text.map((p) => (
              <p class="lead">{p}</p>
            ))}
            <a class="btn btn--ghost" href={`${contact}?chi=${b.audience}`}>
              {b.cta}
            </a>
          </div>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .inv__h {
    margin: clamp(2.5rem, 6vw, 4rem) 0 1.25rem;
    font-size: 1.35rem;
  }

  h4 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .card p {
    margin-bottom: 0;
  }

  .path {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1rem;
  }

  .path__step {
    position: relative;
    border-top: 3px solid var(--cyan-500);
  }

  .path__step:last-child {
    border-top-color: var(--green-300);
  }

  .path__when {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .path__what {
    display: block;
    margin: 0.3rem 0 0.5rem;
    font-size: 1.6rem;
    color: var(--accent);
  }

  .path__step:last-child .path__what {
    color: var(--green-300);
  }

  .inv__cta {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .inv__cta .lead {
    margin-top: 0;
  }
</style>
