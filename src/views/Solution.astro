---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import SampleDashboard from '../components/samples/SampleDashboard.astro';
import SampleReport from '../components/samples/SampleReport.astro';
import { STATS } from '../config';
import { href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  it: {
    title: 'La soluzione: controllo qualità tessile con IA',
    description:
      'Come funziona BrainTex: visione artificiale e intelligenza artificiale che si integrano sui macchinari tessili esistenti, localizzano i difetti e producono mappa e report di ogni pezza.',
    eyebrow: 'La soluzione',
    h1: 'Un sistema che impara il tuo tessuto e non perde un metro.',
    lead: 'BrainTex è un sistema innovativo di controllo qualità: si integra con i macchinari lungo la filiera tessile e usa l’intelligenza artificiale per rilevare i difetti.',
    techEyebrow: 'La tecnologia Brain',
    techTitle: 'Guarda, capisce, segnala.',
    techText:
      'Il sistema di visione inquadra il tessuto mentre avanza. L’intelligenza artificiale analizza ogni immagine e restituisce posizione e contorno di ogni difetto.',
    views: [
      { title: 'Cosa vede la camera', text: 'L’immagine acquisita sul tessuto in movimento.' },
      { title: 'Cosa vedi tu', text: 'Lo stesso tratto di pezza, come appare a occhio nudo.' },
      { title: 'Cosa vede BrainTex', text: 'Il difetto localizzato e contornato dal sistema.' },
    ],
    imagePlaceholder: 'Immagine in arrivo',
    featEyebrow: 'Le caratteristiche',
    featTitle: 'Pensato per la produzione vera.',
    features: [
      {
        title: 'Autonomia',
        text: `Impara da solo e si adatta in fretta quando cambia il tessuto: meno di ${STATS.minutesToLearnFabric} minuti per un articolo nuovo.`,
      },
      {
        title: 'Localizzazione',
        text: 'Individua e contorna il difetto con precisione, per evitare rilavorazioni inutili.',
      },
      {
        title: 'Adattabilità',
        text: 'Un sistema flessibile, che si regola sulle esigenze della produzione con un clic.',
      },
      {
        title: 'Complessità',
        text: 'Rileva difetti invisibili all’occhio umano, anche su disegni complessi.',
      },
    ],
    outEyebrow: 'Cosa ottieni',
    outTitle: 'Ogni pezza ha la sua storia, scritta in dati.',
    outputs: [
      {
        title: 'Avviso immediato',
        text: 'L’operatore riceve la segnalazione in tempo reale, su tablet o con un segnale luminoso.',
      },
      {
        title: 'Mappa dei difetti',
        text: 'Per ogni pezza, la posizione di ogni difetto lungo il tessuto.',
      },
      {
        title: 'Report per pezza',
        text: 'Un documento chiaro per la qualità interna e per rispondere a richieste o contestazioni.',
      },
    ],
    reportEyebrow: 'Il report, in pratica',
    reportTitle: 'Com’è fatto il report di una pezza.',
    reportText:
      'Anagrafica, misure, mappa digitale, elenco dei difetti, grafico, commenti dell’operatore e indicazioni dell’AI: tutto in un documento, pronto per la qualità interna o per chi riceve il tessuto.',
    dashEyebrow: 'Il cruscotto, in pratica',
    dashTitle: 'Un patrimonio di dati che oggi quasi nessuno usa.',
    dashText:
      'Ogni fase produce informazioni. BrainTex le raccoglie in un unico cruscotto, le mette in relazione e ti dice cosa significano.',
    numbers: [
      { value: `${STATS.speedVsManual.toLocaleString('it-IT')}×`, label: 'più veloce del controllo manuale' },
      { value: `${STATS.maxSpeedMps} m/s`, label: 'velocità massima di ispezione' },
      { value: `< ${STATS.minutesToLearnFabric} min`, label: 'per imparare un nuovo articolo' },
      { value: `~${STATS.powerWatts} W`, label: 'di assorbimento, un consumo contenuto' },
    ],
    numbersLabel: 'BrainTex in numeri',
    howEyebrow: 'Come ragiona',
    howTitle: 'Non conta difetti: impara, distingue, si adatta.',
    concepts: [
      {
        title: 'Su misura per te',
        text: 'Modelli specifici per la tua azienda e per ogni articolo: difetti, classi e soglie seguono il tuo capitolato.',
      },
      {
        title: 'Impara dai tuoi operatori',
        text: 'Chi lavora conferma o scarta ogni segnalazione, e il sistema impara da quelle scelte.',
      },
      {
        title: 'Sa distinguere',
        text: 'Riconosce un difetto da una variazione voluta del disegno o della struttura, ne indica classe e gravità ed evita allarmi inutili.',
      },
      {
        title: 'Si adatta in fretta',
        text: `Impara un nuovo articolo in meno di ${STATS.minutesToLearnFabric} minuti, senza raccogliere dataset: perfetto per lotti piccoli e sempre diversi.`,
      },
      {
        title: 'Dialoga con la macchina',
        text: 'Si sincronizza con l’avanzamento del tessuto e, quando serve, invia un avviso o ferma la macchina.',
      },
      {
        title: 'Il sapere resta in azienda',
        text: 'L’esperienza di chi controlla da anni diventa conoscenza del sistema, a disposizione anche di chi arriva dopo.',
      },
    ],
    phasesEyebrow: 'Dove si installa',
    phasesTitle: 'Sui macchinari che hai già, lungo tutta la filiera.',
    phasesText:
      'BrainTex si monta sulle macchine esistenti. Raccontaci la tua produzione: valutiamo insieme dove porta più valore.',
    phases: [
      { title: 'Tessitura', text: 'Maglieria e telai: il difetto si vede dove nasce, prima che si ripeta per metri.' },
      { title: 'Finissaggio', text: 'Rameuse e lavaggio: niente lavorazioni su un tessuto già difettoso.' },
      { title: 'Controllo del greggio', text: 'Il controllo integrato in macchina: un passaggio in meno, consegne più rapide.' },
      { title: 'Controllo finito', text: 'In specola, il 100% del tessuto prima della consegna, con mappa e report.' },
    ],
    qcEyebrow: 'Controllo qualità conto terzi',
    qcTitle: 'Controlli i tessuti degli altri? Qui la qualità è il tuo prodotto.',
    qcText:
      'Se il controllo è il tuo mestiere, BrainTex lavora accanto ai tuoi operatori in specola: loro decidono, il sistema non si stanca.',
    qc: [
      {
        title: 'Benessere di chi controlla',
        text: 'Ore di attenzione continua pesano su vista, postura e concentrazione. Il sistema guarda ogni centimetro e chiama l’operatore solo dove serve.',
      },
      {
        title: 'Più velocità',
        text: 'L’ispezione procede a circa 2,5 volte il controllo manuale, fino a 1 m/s, con lo stesso criterio dal primo all’ultimo metro.',
      },
      {
        title: 'Più capacità produttiva',
        text: 'Più metri controllati con le stesse persone e le stesse postazioni: accetti più lavoro senza allungare i tempi di consegna.',
      },
      {
        title: 'Un report per ogni committente',
        text: 'Ogni pezza esce con mappa dei difetti e report: un servizio in più da offrire, e meno discussioni.',
      },
    ],
    qcCta: 'Parliamo del tuo reparto',
    trustEyebrow: 'Dati e proprietà intellettuale',
    trustTitle: 'I tuoi dati restano tuoi.',
    trust: [
      'I modelli sono addestrati per ogni singolo cliente e non vengono usati per altre aziende; il trattamento di immagini e dati è definito nel contratto.',
      'La tecnologia BrainTex è protetta da una domanda di brevetto depositata.',
    ],
    ctaTitle: 'Provalo sul tuo tessuto.',
    ctaText: 'Raccontaci la tua produzione: valutiamo insieme dove BrainTex può portare più valore.',
    ctaButton: 'Contattaci',
  },
  en: {
    title: 'The solution: AI-powered textile quality control',
    description:
      'How BrainTex works: machine vision and artificial intelligence that integrate with existing textile machines, locate defects and produce a defect map and report for every piece.',
    eyebrow: 'The solution',
    h1: 'A system that learns your fabric and never misses a metre.',
    lead: 'BrainTex is an innovative quality control system: it integrates with machines along the textile supply chain and uses artificial intelligence to detect defects.',
    techEyebrow: 'The Brain technology',
    techTitle: 'It sees, understands, flags.',
    techText:
      'The vision system frames the fabric as it moves. Artificial intelligence analyses every image and returns the position and outline of each defect.',
    views: [
      { title: 'What the camera sees', text: 'The image captured on the moving fabric.' },
      { title: 'What you see', text: 'The same stretch of fabric, as it looks to the naked eye.' },
      { title: 'What BrainTex sees', text: 'The defect located and outlined by the system.' },
    ],
    imagePlaceholder: 'Image coming soon',
    featEyebrow: 'Features',
    featTitle: 'Built for real production.',
    features: [
      {
        title: 'Autonomy',
        text: `It learns on its own and adapts quickly when the fabric changes: less than ${STATS.minutesToLearnFabric} minutes for a new article.`,
      },
      {
        title: 'Localisation',
        text: 'It pinpoints and outlines each defect precisely, to avoid unnecessary rework.',
      },
      {
        title: 'Adaptability',
        text: 'A flexible system that adjusts to production needs with one click.',
      },
      {
        title: 'Complexity',
        text: 'It detects defects invisible to the human eye, even on complex patterns.',
      },
    ],
    outEyebrow: 'What you get',
    outTitle: 'Every piece has its story, written in data.',
    outputs: [
      {
        title: 'Instant alert',
        text: 'The operator is alerted in real time, on a tablet or with a light signal.',
      },
      { title: 'Defect map', text: 'For every piece, the position of each defect along the fabric.' },
      {
        title: 'Report per piece',
        text: 'A clear document for internal quality and for answering requests or disputes.',
      },
    ],
    reportEyebrow: 'The report, in practice',
    reportTitle: 'What a piece report looks like.',
    reportText:
      'Piece record, measurements, digital map, defect list, chart, operator comments and AI insights: all in one document, ready for internal quality or for whoever receives the fabric.',
    dashEyebrow: 'The dashboard, in practice',
    dashTitle: 'A wealth of data that almost nobody uses today.',
    dashText:
      'Every stage generates information. BrainTex gathers it in a single dashboard, relates it and tells you what it means.',
    numbers: [
      { value: `${STATS.speedVsManual.toLocaleString('en-GB')}×`, label: 'faster than manual inspection' },
      { value: `${STATS.maxSpeedMps} m/s`, label: 'maximum inspection speed' },
      { value: `< ${STATS.minutesToLearnFabric} min`, label: 'to learn a new article' },
      { value: `~${STATS.powerWatts} W`, label: 'power draw, a low consumption' },
    ],
    numbersLabel: 'BrainTex in numbers',
    howEyebrow: 'How it thinks',
    howTitle: 'It doesn’t just count defects: it learns, distinguishes, adapts.',
    concepts: [
      {
        title: 'Tailored to you',
        text: 'Models specific to your company and to each article: defects, classes and thresholds follow your specifications.',
      },
      {
        title: 'Learns from your operators',
        text: 'Operators confirm or dismiss every alert, and the system learns from their choices.',
      },
      {
        title: 'Knows the difference',
        text: 'It tells a defect from an intended variation in the pattern or structure, assigns class and severity and avoids needless alarms.',
      },
      {
        title: 'Adapts fast',
        text: `It learns a new article in less than ${STATS.minutesToLearnFabric} minutes, without collecting datasets: ideal for small, ever-changing batches.`,
      },
      {
        title: 'Talks to the machine',
        text: 'It syncs with the movement of the fabric and, when needed, sends an alert or stops the machine.',
      },
      {
        title: 'Know-how stays in-house',
        text: 'The experience of your best inspectors becomes knowledge of the system, available to those who come after.',
      },
    ],
    phasesEyebrow: 'Where it fits',
    phasesTitle: 'On the machines you already have, along the whole chain.',
    phasesText:
      'BrainTex is mounted on existing machines. Tell us about your production: together we will assess where it adds the most value.',
    phases: [
      { title: 'Weaving and knitting', text: 'Looms and knitting machines: the defect is seen where it starts, before it repeats for metres.' },
      { title: 'Finishing', text: 'Stenters and washing: no processing of fabric that is already defective.' },
      { title: 'Greige inspection', text: 'Inspection built into the machine: one step less, faster deliveries.' },
      { title: 'Final inspection', text: 'On the inspection table, 100% of the fabric before delivery, with defect map and report.' },
    ],
    qcEyebrow: 'Quality control as a service',
    qcTitle: 'Do you inspect other companies’ fabrics? Here quality is your product.',
    qcText:
      'If inspection is your business, BrainTex works next to your operators at the inspection table: they decide, the system never gets tired.',
    qc: [
      {
        title: 'Wellbeing of inspectors',
        text: 'Hours of continuous attention weigh on eyesight, posture and concentration. The system watches every centimetre and calls the operator only where needed.',
      },
      {
        title: 'More speed',
        text: 'Inspection runs at about 2.5 times manual inspection, up to 1 m/s, with the same criteria from the first metre to the last.',
      },
      {
        title: 'More capacity',
        text: 'More metres inspected with the same people and the same stations: you take on more work without longer lead times.',
      },
      {
        title: 'A report for every customer',
        text: 'Every piece leaves with a defect map and report: one more service to offer, and fewer disputes.',
      },
    ],
    qcCta: 'Let’s talk about your department',
    trustEyebrow: 'Data and intellectual property',
    trustTitle: 'Your data stays yours.',
    trust: [
      'Models are trained for each individual customer and are not used for other companies; the processing of images and data is defined in the contract.',
      'BrainTex technology is protected by a filed patent application.',
    ],
    ctaTitle: 'Try it on your fabric.',
    ctaText: 'Tell us about your production: together we will assess where BrainTex can add the most value.',
    ctaButton: 'Contact us',
  },
}[lang];

---

<Base lang={lang} routeKey="solution" title={t.title} description={t.description}>
  <PageHero eyebrow={t.eyebrow} title={t.h1} lead={t.lead} />

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.techEyebrow}</p>
        <h2>{t.techTitle}</h2>
        <p class="lead">{t.techText}</p>
      </div>
      <ol class="grid grid--3 views">
        {
          t.views.map((v, i) => (
            <li data-reveal={String(i + 1)}>
              <div class="placeholder views__img">{t.imagePlaceholder}</div>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--raised">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.featEyebrow}</p>
        <h2>{t.featTitle}</h2>
      </div>
      <ul class="grid grid--4 plain">
        {
          t.features.map((f, i) => (
            <li class="card" data-reveal={String(i + 1)}>
              <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.outEyebrow}</p>
        <h2>{t.outTitle}</h2>
      </div>
      <ul class="grid grid--3 plain">
        {
          t.outputs.map((o, i) => (
            <li class="card" data-reveal={String(i + 1)}>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="report" class="section section--raised">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.reportEyebrow}</p>
        <h2>{t.reportTitle}</h2>
        <p class="lead">{t.reportText}</p>
      </div>
      <SampleReport lang={lang} />
    </div>
  </section>

  <section id="cruscotto" class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.dashEyebrow}</p>
        <h2>{t.dashTitle}</h2>
        <p class="lead">{t.dashText}</p>
      </div>
      <SampleDashboard lang={lang} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.howEyebrow}</p>
        <h2>{t.howTitle}</h2>
      </div>
      <ul class="grid grid--3 plain">
        {
          t.concepts.map((k, i) => (
            <li class="card" data-reveal={String((i % 3) + 1)}>
              <h3>{k.title}</h3>
              <p>{k.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.phasesEyebrow}</p>
        <h2>{t.phasesTitle}</h2>
        <p class="lead">{t.phasesText}</p>
      </div>
      <ol class="grid grid--4 plain">
        {
          t.phases.map((ph, i) => (
            <li class="card" data-reveal={String(i + 1)}>
              <span class="card__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{ph.title}</h3>
              <p>{ph.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="conto-terzi" class="section section--raised">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.qcEyebrow}</p>
        <h2>{t.qcTitle}</h2>
        <p class="lead">{t.qcText}</p>
      </div>
      <ul class="grid grid--4 plain">
        {
          t.qc.map((item, i) => (
            <li class="card" data-reveal={String(i + 1)}>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="qc-cta" data-reveal>
        <a class="btn btn--ghost" href={`${href('contact', lang)}?chi=terzista`}>{t.qcCta}</a>
      </p>
    </div>
  </section>

  <section class="numbers" aria-label={t.numbersLabel}>
    <ul class="wrap numbers__list plain">
      {
        t.numbers.map((n, i) => (
          <li data-reveal={String(i + 1)}>
            <strong>{n.value}</strong>
            <span>{n.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t.trustEyebrow}</p>
        <h2>{t.trustTitle}</h2>
      </div>
      <div class="grid grid--2">
        {t.trust.map((p, i) => <p class="lead" data-reveal={String(i + 1)}>{p}</p>)}
      </div>
    </div>
  </section>

  <CtaBand title={t.ctaTitle} text={t.ctaText} button={t.ctaButton} link={href('contact', lang)} />
</Base>

<style>
  .qc-cta {
    margin: 2rem 0 0;
  }

  .views {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .views__img {
    aspect-ratio: 4 / 3;
    margin-bottom: 1.25rem;
  }

  .numbers {
    border-block: 1px solid var(--line);
    background: var(--bg-deep);
  }

  .numbers__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1.5rem;
    padding-block: 2.5rem;
  }

  .numbers__list li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .numbers__list strong {
    font-size: clamp(2rem, 1.6rem + 1.8vw, 2.8rem);
    line-height: 1;
    color: var(--green-300);
    font-variant-numeric: tabular-nums;
  }

  .numbers__list span {
    color: var(--text-muted);
  }
</style>
