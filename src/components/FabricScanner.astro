---
// Illustrazione interattiva: la pezza avanza (da sola e con lo scroll) sotto una linea di scansione.
// Il sistema conta tutti i difetti; per ogni classe si sceglie se filtrarla, mostrarla sul tablet o farla allarmare.
// Simulazione illustrativa con dati inventati: nessun dato reale.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const KINDS = ['stain', 'pull', 'knot', 'weft', 'hole'] as const;
// Impostazione iniziale di ogni classe: i nodini sono contati ma non disturbano l'operatore.
const DEFAULT_MODE = { stain: 'show', pull: 'show', knot: 'filter', weft: 'alarm', hole: 'alarm' } as const;
const MODES = ['filter', 'show', 'alarm'] as const;

const t = {
  it: {
    label: 'Simulazione: un tessuto scorre sotto la linea di ispezione e i difetti vengono evidenziati',
    meters: 'm ispezionati',
    total: 'difetti contati',
    filtered: 'filtrati',
    alarms: 'allarmi',
    note: 'Simulazione illustrativa, dati di esempio',
    kinds: { stain: 'Macchia', pull: 'Filo tirato', knot: 'Nodo', weft: 'Trama mancante', hole: 'Buco' },
    modes: { filter: 'Filtra', show: 'Mostra', alarm: 'Allarma' },
    viewLabel: 'Vista',
    viewHuman: 'Come vedi tu',
    viewSystem: 'Come vede il sistema',
    heatLow: 'conforme',
    heatHigh: 'anomalia',
    tablet: 'Tablet dell’operatore',
    tabletEmpty: 'Nessun difetto da mostrare',
    alarm: 'Allarme · {kind}: 3 volte in 2 m',
    classesTitle: 'Classi di difetto: decidi tu cosa vedere',
    classesText:
      'BrainTex conta tutto. Tu scegli, classe per classe, cosa nascondere all’operatore, cosa mostrargli e cosa deve far scattare un allarme.',
    rule: 'Regola di esempio: scatta l’allarme se la stessa classe si ripete 3 volte in 2 metri.',
    modeFor: 'Cosa fare con',
    pieceTitle: 'Scheda della pezza',
    piece: [
      ['Pezza', 'P-000482'],
      ['Articolo', 'Esempio 100'],
      ['Disegno e colore', 'Tinta unita, blu'],
      ['Lotto', 'L-24'],
      ['Altezza', '150 cm'],
      ['Macchina', 'Telaio 07'],
      ['Capitolato', 'Standard di esempio'],
    ],
  },
  en: {
    label: 'Simulation: fabric moves under the inspection line and defects are highlighted',
    meters: 'm inspected',
    total: 'defects counted',
    filtered: 'filtered',
    alarms: 'alarms',
    note: 'Illustrative simulation, sample data',
    kinds: { stain: 'Stain', pull: 'Pulled thread', knot: 'Knot', weft: 'Missing weft', hole: 'Hole' },
    modes: { filter: 'Filter', show: 'Show', alarm: 'Alarm' },
    viewLabel: 'View',
    viewHuman: 'What you see',
    viewSystem: 'What the system sees',
    heatLow: 'compliant',
    heatHigh: 'anomaly',
    tablet: 'Operator tablet',
    tabletEmpty: 'No defects to show',
    alarm: 'Alarm · {kind}: 3 times in 2 m',
    classesTitle: 'Defect classes: you decide what to see',
    classesText:
      'BrainTex counts everything. Class by class, you choose what to hide from the operator, what to show and what must trigger an alarm.',
    rule: 'Sample rule: the alarm goes off when the same class occurs 3 times within 2 metres.',
    modeFor: 'What to do with',
    pieceTitle: 'Piece record',
    piece: [
      ['Piece', 'P-000482'],
      ['Article', 'Sample 100'],
      ['Pattern and colour', 'Plain, blue'],
      ['Lot', 'L-24'],
      ['Width', '150 cm'],
      ['Machine', 'Loom 07'],
      ['Specification', 'Sample standard'],
    ],
  },
}[lang];

// Posizioni (percentuali) dei difetti nel "modulo" di tessuto che si ripete.
const slots = [
  { x: 22, y: 6 },
  { x: 62, y: 20 },
  { x: 38, y: 34 },
  { x: 8, y: 48 },
  { x: 74, y: 62 },
  { x: 30, y: 76 },
  { x: 54, y: 90 },
];

const texts = JSON.stringify({ kinds: t.kinds, alarm: t.alarm, empty: t.tabletEmpty });
---

<figure class="scanner" aria-label={t.label} data-scanner data-lang={lang} data-texts={texts}>
  <div class="scanner__window">
    <div class="scanner__fabric" data-fabric></div>
    {
      slots.map((s) => (
        <span class={`defect defect--x${s.x}`} data-defect data-y={s.y} aria-hidden="true">
          <span class="defect__mark" />
          <span class="defect__label" />
        </span>
      ))
    }
    <span class="scanner__line" aria-hidden="true"></span>

    <div class="view-toggle" role="group" aria-label={t.viewLabel}>
      <button type="button" aria-pressed="false" data-view="human">{t.viewHuman}</button>
      <button type="button" aria-pressed="true" data-view="system">{t.viewSystem}</button>
    </div>
    <p class="heat-legend" aria-hidden="true">
      <span>{t.heatLow}</span>
      <span class="heat-legend__bar"></span>
      <span>{t.heatHigh}</span>
    </p>

    <div class="tablet" data-tablet>
      <p class="tablet__title">{t.tablet}</p>
      <p class="tablet__alarm" data-alarm role="status" aria-live="polite"></p>
      <ol class="tablet__list" data-tablet-list>
        <li class="tablet__empty">{t.tabletEmpty}</li>
      </ol>
    </div>
  </div>

  <figcaption class="scanner__hud">
    <span><strong data-meters>0,0</strong> <small>{t.meters}</small></span>
    <span><strong data-total>0</strong> <small>{t.total}</small></span>
    <span><strong data-filtered>0</strong> <small>{t.filtered}</small></span>
    <span><strong data-alarms>0</strong> <small>{t.alarms}</small></span>
  </figcaption>

  <details class="panel" open>
    <summary>{t.classesTitle}</summary>
    <div class="panel__body">
      <p>{t.classesText}</p>
      {
        KINDS.map((kind) => (
          <div class="klass" role="radiogroup" aria-label={`${t.modeFor} ${t.kinds[kind]}`}>
            <span class="klass__name">{t.kinds[kind]}</span>
            <div class="klass__modes">
              {MODES.map((mode) => (
                <label class={`klass__mode klass__mode--${mode}`}>
                  <input type="radio" name={`scan-${kind}`} value={mode} data-kind={kind} checked={DEFAULT_MODE[kind] === mode} />
                  <span>{t.modes[mode]}</span>
                </label>
              ))}
            </div>
          </div>
        ))
      }
      <p class="panel__rule">{t.rule}</p>
    </div>
  </details>

  <details class="panel">
    <summary>{t.pieceTitle}</summary>
    <dl class="panel__body piece">
      {
        t.piece.map(([term, value]) => (
          <div>
            <dt>{term}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>
  </details>

  <p class="scanner__note">{t.note}</p>
</figure>

<style>
  .scanner {
    --alarm: #ffc857;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    overflow: hidden;
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6);
  }

  .scanner__window {
    position: relative;
    height: clamp(17rem, 38vw, 23rem);
    overflow: hidden;
  }

  /* Tessuto: ordito e trama disegnati con gradienti, nessuna immagine */
  .scanner__fabric {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(90deg, rgb(53 210 243 / 0.14) 0 2px, transparent 2px 7px),
      repeating-linear-gradient(0deg, rgb(19 115 168 / 0.35) 0 3px, transparent 3px 7px),
      linear-gradient(180deg, #003359, #00284a);
  }

  .scanner__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 55%;
    height: 2px;
    background: var(--cyan-200);
    box-shadow:
      0 0 12px 2px rgb(87 240 254 / 0.7),
      0 0 60px 12px rgb(87 240 254 / 0.18);
  }

  .scanner__line::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 55%;
    min-height: 6rem;
    background: linear-gradient(0deg, rgb(87 240 254 / 0.08), transparent);
    pointer-events: none;
  }

  .defect {
    position: absolute;
    top: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    will-change: transform;
  }

  .defect.is-empty {
    visibility: hidden;
  }

  .defect--x8 { left: 8%; }
  .defect--x22 { left: 22%; }
  .defect--x30 { left: 30%; }
  .defect--x38 { left: 38%; }
  .defect--x54 { left: 54%; }
  .defect--x62 { left: 62%; }
  .defect--x74 { left: 74%; }

  .defect__mark {
    position: relative;
    display: block;
    outline: 1.5px solid transparent;
    outline-offset: 6px;
    border-radius: 3px;
    transition:
      outline-color 0.25s,
      box-shadow 0.25s;
  }

  .defect--stain .defect__mark {
    width: 26px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(0 15 30 / 0.85), rgb(0 15 30 / 0.2));
  }

  .defect--pull .defect__mark {
    width: 4px;
    height: 46px;
    background: linear-gradient(180deg, transparent, rgb(140 220 255 / 0.9), transparent);
  }

  .defect--knot .defect__mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(150 225 255 / 0.85);
  }

  .defect--weft .defect__mark {
    width: 110px;
    height: 5px;
    background: rgb(0 15 30 / 0.9);
  }

  .defect--hole .defect__mark {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg-deep);
    box-shadow: inset 0 0 0 2px rgb(0 0 0 / 0.5);
  }

  .defect__label {
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    background: var(--green-300);
    color: var(--bg-deep);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }

  .defect.is-found .defect__mark {
    outline-color: var(--green-300);
    box-shadow: 0 0 18px rgb(156 237 64 / 0.45);
  }

  .defect.is-found .defect__label {
    opacity: 1;
    transform: none;
  }

  /* Classe filtrata: contata, ma segnata appena e senza etichetta */
  .defect.is-filtered .defect__mark {
    outline: 1px dashed rgb(169 196 214 / 0.55);
  }

  /* Come vede il sistema: ogni difetto si accende di un alone, più caldo quanto più è grave */
  .defect__mark::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 50%;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgb(156 237 64 / 0.85), rgb(53 210 243 / 0.45) 45%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .defect--weft .defect__mark::before {
    width: 180px;
    height: 64px;
  }

  .defect--pull .defect__mark::before {
    width: 60px;
    height: 110px;
  }

  .defect.is-found .defect__mark::before {
    opacity: 1;
  }

  .defect.is-filtered .defect__mark::before {
    opacity: 0.45;
    background: radial-gradient(circle, rgb(53 210 243 / 0.6), transparent 65%);
  }

  .defect.is-alarm .defect__mark::before {
    background: radial-gradient(circle, rgb(255 140 90 / 0.95), rgb(255 200 87 / 0.7) 40%, transparent 72%);
  }

  .scanner__fabric {
    transition: filter 0.3s;
  }

  .scanner:not(.is-human) .scanner__fabric {
    filter: saturate(0.4) brightness(0.7);
  }

  .view-toggle {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: flex;
    border: 1px solid rgb(169 196 214 / 0.45);
    border-radius: 999px;
    background: rgb(0 23 42 / 0.85);
    overflow: hidden;
  }

  .view-toggle button {
    padding: 0.3rem 0.75rem;
    border: 0;
    background: transparent;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .view-toggle button[aria-pressed='true'] {
    background: var(--cyan-200);
    color: var(--bg-deep);
    font-weight: 700;
  }

  .view-toggle button:focus-visible {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }

  .heat-legend {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgb(0 23 42 / 0.85);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .is-human .heat-legend {
    display: none;
  }

  .heat-legend__bar {
    width: 4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(53 210 243 / 0.6), rgb(156 237 64), rgb(255 200 87), rgb(255 140 90));
  }

  .defect.is-alarm .defect__mark {
    outline-color: var(--alarm);
    box-shadow: 0 0 18px rgb(255 200 87 / 0.55);
  }

  .defect.is-alarm .defect__label {
    background: var(--alarm);
  }

  /* Tablet dell'operatore, sovrapposto alla pezza */
  .tablet {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    width: min(13.5rem, 55%);
    padding: 0.6rem 0.7rem;
    border: 2px solid rgb(169 196 214 / 0.5);
    border-radius: 10px;
    background: rgb(0 23 42 / 0.92);
    font-size: 0.78rem;
  }

  .tablet__title {
    margin: 0 0 0.35rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tablet__alarm {
    margin: 0 0 0.35rem;
    padding: 0.3rem 0.45rem;
    border-radius: 5px;
    background: var(--alarm);
    color: var(--bg-deep);
    font-weight: 700;
    line-height: 1.25;
  }

  .tablet__alarm:empty {
    display: none;
  }

  .tablet__list {
    margin: 0;
    padding: 0;
    list-style: none;
    min-height: 4.6rem;
  }

  .tablet__list :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.12rem 0;
  }

  .tablet__list :global(.is-alarm) {
    color: var(--alarm);
    font-weight: 700;
  }

  .tablet__list :global(.tablet__empty) {
    color: var(--text-muted);
  }

  .tablet.is-alarm {
    border-color: var(--alarm);
  }

  @media (prefers-reduced-motion: no-preference) {
    .tablet.is-alarm {
      animation: alarm-flash 0.6s steps(2, jump-none) infinite;
    }
  }

  @keyframes alarm-flash {
    from {
      box-shadow: 0 0 0 0 rgb(255 200 87 / 0);
    }
    to {
      box-shadow: 0 0 0 5px rgb(255 200 87 / 0.55);
    }
  }

  .scanner__hud {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
    padding: 0.8rem 1.1rem;
    border-top: 1px solid var(--line);
  }

  .scanner__hud span {
    display: flex;
    flex-direction: column;
  }

  .scanner__hud strong {
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    color: var(--text);
  }

  .scanner__hud small {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .panel {
    border-top: 1px solid var(--line);
  }

  .panel summary {
    padding: 0.8rem 1.1rem;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .panel summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .panel__body {
    margin: 0;
    padding: 0 1.1rem 1rem;
    font-size: 0.85rem;
  }

  .panel__body p {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
  }

  .panel__body .panel__rule {
    margin: 0.75rem 0 0;
    font-style: italic;
  }

  .klass {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.25rem 0;
  }

  .klass__name {
    font-weight: 700;
  }

  .klass__modes {
    display: flex;
    border: 1px solid rgb(169 196 214 / 0.45);
    border-radius: 999px;
    overflow: hidden;
  }

  .klass__mode {
    position: relative;
    cursor: pointer;
  }

  .klass__mode input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .klass__mode span {
    display: block;
    padding: 0.3rem 0.7rem;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .klass__mode input:checked + span {
    background: var(--cyan-200);
    color: var(--bg-deep);
    font-weight: 700;
  }

  .klass__mode--filter input:checked + span {
    background: rgb(169 196 214 / 0.85);
  }

  .klass__mode--alarm input:checked + span {
    background: var(--alarm);
  }

  .klass__mode input:focus-visible + span {
    outline: 2px solid var(--text);
    outline-offset: -2px;
  }

  .piece {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.6rem 1rem;
  }

  .piece dt {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .piece dd {
    margin: 0;
    font-weight: 700;
  }

  .scanner__note {
    margin: 0;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--line);
    font-size: 0.75rem;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Come vedi tu: il tessuto e basta, i difetti si notano a fatica come a occhio nudo */
  .is-human .defect .defect__mark {
    outline-color: transparent;
    box-shadow: none;
  }

  .is-human .defect .defect__mark::before {
    opacity: 0;
  }

  .is-human .defect .defect__label {
    opacity: 0;
  }
</style>

<script>
  type Kind = 'stain' | 'pull' | 'knot' | 'weft' | 'hole';
  type Mode = 'filter' | 'show' | 'alarm';

  // Sequenza fissa dei difetti che entrano (null = tratto pulito): contiene piccole "raffiche"
  // della stessa classe, per far vedere quando scatta la regola di allarme.
  const SEQUENCE: (Kind | null)[] = [
    'knot', null, 'stain', 'knot', null, 'pull', null, 'knot', 'hole', null, null, 'knot',
    'weft', 'weft', 'weft', null, 'knot', null, 'pull', null, 'stain', 'knot', null, null,
    'knot', 'pull', null, 'hole', 'hole', 'knot', 'hole', null, 'stain', 'stain', 'knot', 'stain',
  ];
  const KIND_CLASSES = ['stain', 'pull', 'knot', 'weft', 'hole'].map((k) => `defect--${k}`);
  const PX_PER_METRE = 400; // scala della simulazione
  const SPEED = 42; // px al secondo
  const RULE_COUNT = 3;
  const RULE_METRES = 2;
  const ALARM_SECONDS = 4;

  const root = document.querySelector<HTMLElement>('[data-scanner]');
  if (root) {
    const win = root.querySelector<HTMLElement>('.scanner__window')!;
    const fabric = root.querySelector<HTMLElement>('[data-fabric]')!;
    const tablet = root.querySelector<HTMLElement>('[data-tablet]')!;
    const list = root.querySelector<HTMLElement>('[data-tablet-list]')!;
    const alarmEl = root.querySelector<HTMLElement>('[data-alarm]')!;
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-${name}]`)!;
    const metersEl = out('meters');
    const totalEl = out('total');
    const filteredEl = out('filtered');
    const alarmsEl = out('alarms');
    const texts = JSON.parse(root.dataset.texts ?? '{}') as {
      kinds: Record<Kind, string>;
      alarm: string;
      empty: string;
    };
    const locale = root.dataset.lang === 'en' ? 'en-GB' : 'it-IT';
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const fmt = (metres: number) =>
      metres.toLocaleString(locale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    let next = 0;
    const items = [...root.querySelectorAll<HTMLElement>('[data-defect]')].map((el) => ({
      el,
      label: el.querySelector<HTMLElement>('.defect__label')!,
      y: Number(el.dataset.y) / 100,
      kind: null as Kind | null,
      wasBelow: true,
    }));
    type Item = (typeof items)[number];

    // Assegna al difetto la prossima classe della sequenza (quando rientra dal basso).
    const assign = (d: Item) => {
      d.kind = SEQUENCE[next++ % SEQUENCE.length];
      d.el.classList.remove(...KIND_CLASSES, 'is-found', 'is-filtered', 'is-alarm');
      d.el.classList.toggle('is-empty', d.kind === null);
      if (d.kind) {
        d.el.classList.add(`defect--${d.kind}`);
        d.label.textContent = texts.kinds[d.kind];
      }
    };

    const modeOf = (kind: Kind) =>
      (root.querySelector<HTMLInputElement>(`input[data-kind="${kind}"]:checked`)?.value ?? 'show') as Mode;

    let offset = 0;
    let total = 0;
    let filtered = 0;
    let alarms = 0;
    let alarmUntil = 0;
    let visible = true;
    let last = performance.now();
    let lastScroll = scrollY;
    const history: { kind: Kind; at: number }[] = []; // ultimi difetti contati, con la posizione in metri
    const shown: { text: string; alarm: boolean }[] = [];

    const renderTablet = () => {
      list.replaceChildren(
        ...(shown.length
          ? shown.map((row) => {
              const li = document.createElement('li');
              if (row.alarm) li.className = 'is-alarm';
              li.textContent = row.text;
              return li;
            })
          : [Object.assign(document.createElement('li'), { className: 'tablet__empty', textContent: texts.empty })]),
      );
    };

    // Un difetto ha attraversato la linea: si conta sempre, poi si applica la scelta fatta per la sua classe.
    const detect = (d: Item) => {
      if (!d.kind) return;
      const at = offset / PX_PER_METRE;
      total += 1;
      history.push({ kind: d.kind, at });
      while (history.length && history[0].at < at - RULE_METRES) history.shift();

      const mode = modeOf(d.kind);
      if (mode === 'filter') {
        filtered += 1;
        d.el.classList.add('is-filtered');
        return;
      }
      const repeated = history.filter((h) => h.kind === d.kind).length >= RULE_COUNT;
      const alarm = mode === 'alarm' && repeated;
      d.el.classList.add('is-found');
      if (alarm) {
        d.el.classList.add('is-alarm');
        if (performance.now() > alarmUntil) alarms += 1;
        alarmUntil = performance.now() + ALARM_SECONDS * 1000;
        alarmEl.textContent = texts.alarm.replace('{kind}', texts.kinds[d.kind]);
        tablet.classList.add('is-alarm');
      }
      shown.unshift({ text: `${fmt(at)} m · ${texts.kinds[d.kind]}`, alarm });
      shown.length = Math.min(shown.length, 4);
      renderTablet();
    };

    // Posizione verticale di un difetto nella finestra (il tessuto si ripete a moduli).
    const geometry = () => {
      const h = win.clientHeight;
      return { tile: h + 80, scanY: h * 0.55 };
    };
    const posOf = (d: Item, tile: number) => ((((d.y * tile - offset) % tile) + tile) % tile) - 40;

    const render = () => {
      const { tile, scanY } = geometry();
      fabric.style.backgroundPosition = `0 ${-offset}px, 0 ${-offset}px, 0 0`;
      for (const d of items) {
        const y = posOf(d, tile);
        const below = y > scanY;
        if (d.wasBelow && !below) detect(d);
        else if (!d.wasBelow && below) assign(d); // rientra dal basso: nuovo tratto di pezza
        d.wasBelow = below;
        d.el.style.transform = `translateY(${y}px)`;
      }
      if (alarmUntil && performance.now() > alarmUntil) {
        alarmUntil = 0;
        alarmEl.textContent = '';
        tablet.classList.remove('is-alarm');
      }
      metersEl.textContent = fmt(offset / PX_PER_METRE);
      totalEl.textContent = String(total);
      filteredEl.textContent = String(filtered);
      alarmsEl.textContent = String(alarms);
    };

    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.1);
      last = now;
      if (visible && !document.hidden) {
        offset += SPEED * dt;
        render();
      }
      requestAnimationFrame(frame);
    };

    // Lo scroll fa avanzare la pezza: chi scorre la pagina "fa scorrere il tessuto".
    addEventListener(
      'scroll',
      () => {
        const delta = Math.abs(scrollY - lastScroll);
        lastScroll = scrollY;
        if (visible) {
          offset += Math.min(delta * 0.8, 60);
          if (reduced.matches) render();
        }
      },
      { passive: true },
    );

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
    }).observe(root);

    // Come vedi tu (solo il tessuto) / come vede il sistema (aloni, contorni e nomi dei difetti)
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-view]')];
    viewButtons.forEach((b) =>
      b.addEventListener('click', () => {
        root.classList.toggle('is-human', b.dataset.view === 'human');
        viewButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      }),
    );

    // All'avvio i difetti già sopra la linea non contano: si parte da una pezza "nuova".
    const { tile, scanY } = geometry();
    for (const d of items) {
      d.wasBelow = posOf(d, tile) > scanY;
      if (d.wasBelow) assign(d);
      else d.el.classList.add('is-empty');
    }
    render();
    if (!reduced.matches) requestAnimationFrame(frame);
  }
</script>
