---
// Modulo contatti unico per tutti i pubblici: il campo "Chi sei?" finisce nell'oggetto dell'email.
import { href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  it: {
    name: 'Nome e cognome',
    email: 'Email',
    audience: 'Chi sei?',
    choose: 'Scegli…',
    audiences: {
      cliente: 'Azienda tessile (tessitura, tintoria, finissaggio)',
      terzista: 'Controllo qualità conto terzi',
      confezionista: 'Confezionista o brand',
      candidato: 'Candidato',
      agente: 'Agente di commercio o rappresentante',
      investitore: 'Investitore',
      partner: 'Costruttore di macchine o integratore',
      it: 'IT provider o software house (ERP, MES…)',
      fornitore: 'Fornitore',
      progetto: 'Proposta di progetto (bandi, co-sviluppo, ricerca)',
      stampa: 'Stampa',
      altro: 'Altro',
    },
    company: 'Azienda o ente',
    link: 'Profilo LinkedIn o portfolio',
    linkHint: 'Utile soprattutto per le candidature.',
    linkSupplier: 'Sito, catalogo o scheda tecnica',
    linkSupplierHint: 'Un link ci basta: non servono allegati.',
    message: 'Messaggio',
    messageHint: 'Non inserire dati sensibili, ad esempio sulla salute.',
    messageSupplierHint:
      'Descrivi cosa proponi e, se li conosci, tempi di consegna, quantità minime e zone servite. Non inserire dati sensibili.',
    messageAgentHint: 'Raccontaci in breve la tua esperienza. Non inserire dati sensibili.',
    supplierCategory: 'Cosa proponi?',
    supplierCategories: {
      componenti: 'Componenti e materiali',
      lavorazioni: 'Lavorazioni e produzione conto terzi',
      software: 'Software e servizi IT',
      servizi: 'Servizi professionali e consulenza',
      altro: 'Altro',
    },
    agentAreas: 'Zone e distretti che segui',
    agentSectors: 'Settori e tipo di aziende che visiti',
    agentMandates: 'Mandati che hai già',
    agentMandatesHint: 'Ci aiuta a evitare sovrapposizioni.',
    projectType: 'Che tipo di progetto?',
    projectTypes: ['Bando o finanziamento', 'Co-sviluppo', 'Ricerca', 'Altro'],
    projectDeadline: 'Scadenza',
    projectDeadlineHint: 'Per i bandi, la data entro cui presentare la proposta.',
    booking: 'Vuoi fare prima? Prenota una call conoscitiva',
    bookingNote: 'Si apre il calendario di Cal.com in una nuova scheda.',
    topics: {
      fattibilita: 'Vorrei proporvi un’esigenza particolare da valutare: ',
      presentazione: 'Vorrei ricevere la presentazione di BrainTex per investitori.',
      call: 'Vorrei fissare una call conoscitiva con BrainTex.',
    },
    optional: 'facoltativo',
    privacyBefore: 'Ho letto l’',
    privacyLink: 'informativa privacy',
    privacyAfter: '.',
    notice:
      'Titolare del trattamento è BrainTex srl. Usiamo i dati che ci invii solo per rispondere alla tua richiesta e, se ti candidi o ci proponi una collaborazione, una fornitura o un progetto, per valutarli; li conserviamo al massimo 24 mesi. Trovi i dettagli e i tuoi diritti nella ',
    noticeLink: 'Privacy Policy',
    send: 'Invia il messaggio',
    sending: 'Invio in corso…',
    errors: {
      name: 'Scrivi il tuo nome.',
      email: 'Inserisci un indirizzo email valido.',
      audience: 'Scegli una voce.',
      company: 'Indica l’azienda.',
      supplierCategory: 'Scegli una categoria.',
      agentAreas: 'Indica almeno una zona.',
      projectType: 'Scegli il tipo di progetto.',
      link: 'Inserisci un indirizzo web completo (https://…).',
      message: 'Scrivi un messaggio di almeno 10 caratteri.',
      privacy: 'Conferma di aver letto l’informativa privacy.',
    },
    ok: 'Grazie! Il messaggio è arrivato: ti risponderemo il prima possibile.',
    failed: 'Non siamo riusciti a inviare il messaggio. Riprova tra qualche minuto o scrivici su LinkedIn.',
    notConfigured: 'Il modulo non è ancora attivo in questa versione del sito.',
    invalid: 'Controlla i campi evidenziati.',
    noscript: 'Per inviare il modulo serve JavaScript attivo. In alternativa scrivici su LinkedIn.',
    required: 'obbligatorio',
  },
  en: {
    name: 'Full name',
    email: 'Email',
    audience: 'Who are you?',
    choose: 'Choose…',
    audiences: {
      cliente: 'Textile company (weaving, dyeing, finishing)',
      terzista: 'Quality-control service provider',
      confezionista: 'Garment maker or brand',
      candidato: 'Candidate',
      agente: 'Sales agent or representative',
      investitore: 'Investor',
      partner: 'Machine builder or integrator',
      it: 'IT provider or software house (ERP, MES…)',
      fornitore: 'Supplier',
      progetto: 'Project proposal (funding calls, co-development, research)',
      stampa: 'Press',
      altro: 'Other',
    },
    company: 'Company or organisation',
    link: 'LinkedIn profile or portfolio',
    linkHint: 'Especially useful for applications.',
    linkSupplier: 'Website, catalogue or datasheet',
    linkSupplierHint: 'A link is enough: no attachments needed.',
    message: 'Message',
    messageHint: 'Please do not include sensitive data, for example about health.',
    messageSupplierHint:
      'Describe what you offer and, if known, lead times, minimum quantities and areas served. Please do not include sensitive data.',
    messageAgentHint: 'Tell us briefly about your experience. Please do not include sensitive data.',
    supplierCategory: 'What do you offer?',
    supplierCategories: {
      componenti: 'Components and materials',
      lavorazioni: 'Manufacturing and subcontracting',
      software: 'Software and IT services',
      servizi: 'Professional services and consulting',
      altro: 'Other',
    },
    agentAreas: 'Areas and districts you cover',
    agentSectors: 'Sectors and type of companies you visit',
    agentMandates: 'Mandates you already hold',
    agentMandatesHint: 'It helps us avoid overlaps.',
    projectType: 'What kind of project?',
    projectTypes: ['Funding call', 'Co-development', 'Research', 'Other'],
    projectDeadline: 'Deadline',
    projectDeadlineHint: 'For funding calls, the date by which the proposal must be submitted.',
    booking: 'In a hurry? Book an introductory call',
    bookingNote: 'Cal.com opens in a new tab.',
    topics: {
      fattibilita: 'I would like you to assess a specific need: ',
      presentazione: 'I would like to receive the BrainTex investor presentation.',
      call: 'I would like to book an introductory call with BrainTex.',
    },
    optional: 'optional',
    privacyBefore: 'I have read the ',
    privacyLink: 'privacy notice',
    privacyAfter: '.',
    notice:
      'The data controller is BrainTex srl. We use the data you send only to reply to your request and, if you apply or propose a partnership, supply or project, to assess it; we keep it for no longer than 24 months. Details and your rights are in the ',
    noticeLink: 'Privacy Policy',
    send: 'Send message',
    sending: 'Sending…',
    errors: {
      name: 'Please enter your name.',
      email: 'Please enter a valid email address.',
      audience: 'Please choose an option.',
      company: 'Please enter the company.',
      supplierCategory: 'Please choose a category.',
      agentAreas: 'Please enter at least one area.',
      projectType: 'Please choose the type of project.',
      link: 'Please enter a full web address (https://…).',
      message: 'Please write a message of at least 10 characters.',
      privacy: 'Please confirm you have read the privacy notice.',
    },
    ok: 'Thank you! Your message has arrived: we will reply as soon as possible.',
    failed: 'We could not send your message. Please try again in a few minutes or write to us on LinkedIn.',
    notConfigured: 'The form is not active yet in this version of the site.',
    invalid: 'Please check the highlighted fields.',
    noscript: 'JavaScript is required to send this form. Alternatively, write to us on LinkedIn.',
    required: 'required',
  },
}[lang];

// Pagina per prenotare una call (Cal.com), da variabile di build: senza variabile il link non compare.
const bookingEnv = import.meta.env.PUBLIC_BOOKING_URL as string | undefined;
const bookingUrl = bookingEnv?.startsWith('https://') ? bookingEnv : '';

// Messaggi passati allo script tramite attributi data-* (niente script inline, per la CSP).
const messages = JSON.stringify({
  sending: t.sending,
  ok: t.ok,
  failed: t.failed,
  notConfigured: t.notConfigured,
  invalid: t.invalid,
  topics: t.topics,
});

// Testi che cambiano in base a "Chi sei?" (collegamento e suggerimento del messaggio).
const variants = JSON.stringify({
  default: { link: t.link, linkHint: t.linkHint, messageHint: t.messageHint },
  fornitore: { link: t.linkSupplier, linkHint: t.linkSupplierHint, messageHint: t.messageSupplierHint },
  agente: { link: t.link, linkHint: t.linkHint, messageHint: t.messageAgentHint },
});
---

<form class="contact-form" data-contact-form data-messages={messages} data-variants={variants} data-lang={lang} novalidate>
  <noscript><p class="form-status form-status--error">{t.noscript}</p></noscript>

  <div class="field">
    <label for="cf-name">{t.name} <span class="req" aria-hidden="true">*</span></label>
    <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" aria-describedby="cf-name-err" />
    <p class="field__error" id="cf-name-err" data-error={t.errors.name}></p>
  </div>

  <div class="field">
    <label for="cf-email">{t.email} <span class="req" aria-hidden="true">*</span></label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="cf-email-err" />
    <p class="field__error" id="cf-email-err" data-error={t.errors.email}></p>
  </div>

  <div class="field">
    <label for="cf-audience">{t.audience} <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-audience" name="audience" required aria-describedby="cf-audience-err">
      <option value="">{t.choose}</option>
      {Object.entries(t.audiences).map(([value, label]) => <option value={value}>{label}</option>)}
    </select>
    <p class="field__error" id="cf-audience-err" data-error={t.errors.audience}></p>
  </div>

  <div class="field">
    <label for="cf-company">
      {t.company}
      <span class="opt" data-company-optional>({t.optional})</span>
      <span class="req" aria-hidden="true" data-company-required hidden>*</span>
    </label>
    <input id="cf-company" name="company" type="text" autocomplete="organization" maxlength="160" aria-describedby="cf-company-err" />
    <p class="field__error" id="cf-company-err" data-error={t.errors.company}></p>
  </div>

  {/* Campi in più per i fornitori: compaiono solo scegliendo "Fornitore" */}
  <div class="field field--wide" data-for="fornitore" hidden>
    <label for="cf-supplier-category">{t.supplierCategory} <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-supplier-category" name="supplierCategory" required disabled aria-describedby="cf-supplier-category-err">
      <option value="">{t.choose}</option>
      {Object.values(t.supplierCategories).map((label) => <option>{label}</option>)}
    </select>
    <p class="field__error" id="cf-supplier-category-err" data-error={t.errors.supplierCategory}></p>
  </div>

  {/* Campi in più per le proposte di progetto */}
  <div class="field" data-for="progetto" hidden>
    <label for="cf-project-type">{t.projectType} <span class="req" aria-hidden="true">*</span></label>
    <select id="cf-project-type" name="projectType" required disabled aria-describedby="cf-project-type-err">
      <option value="">{t.choose}</option>
      {t.projectTypes.map((label) => <option>{label}</option>)}
    </select>
    <p class="field__error" id="cf-project-type-err" data-error={t.errors.projectType}></p>
  </div>
  <div class="field" data-for="progetto" hidden>
    <label for="cf-project-deadline">{t.projectDeadline} <span class="opt">({t.optional})</span></label>
    <input id="cf-project-deadline" name="projectDeadline" type="date" disabled aria-describedby="cf-project-deadline-hint" />
    <p class="field__hint" id="cf-project-deadline-hint">{t.projectDeadlineHint}</p>
  </div>

  {/* Campi in più per agenti e rappresentanti */}
  <div class="field" data-for="agente" hidden>
    <label for="cf-agent-areas">{t.agentAreas} <span class="req" aria-hidden="true">*</span></label>
    <input id="cf-agent-areas" name="agentAreas" type="text" required disabled maxlength="200" aria-describedby="cf-agent-areas-err" />
    <p class="field__error" id="cf-agent-areas-err" data-error={t.errors.agentAreas}></p>
  </div>
  <div class="field" data-for="agente" hidden>
    <label for="cf-agent-sectors">{t.agentSectors} <span class="opt">({t.optional})</span></label>
    <input id="cf-agent-sectors" name="agentSectors" type="text" disabled maxlength="200" />
  </div>
  <div class="field field--wide" data-for="agente" hidden>
    <label for="cf-agent-mandates">{t.agentMandates} <span class="opt">({t.optional})</span></label>
    <input id="cf-agent-mandates" name="agentMandates" type="text" disabled maxlength="300" aria-describedby="cf-agent-mandates-hint" />
    <p class="field__hint" id="cf-agent-mandates-hint">{t.agentMandatesHint}</p>
  </div>

  <div class="field field--wide">
    <label for="cf-link"><span data-link-label>{t.link}</span> <span class="opt">({t.optional})</span></label>
    <input id="cf-link" name="link" type="url" inputmode="url" placeholder="https://" maxlength="300" aria-describedby="cf-link-hint cf-link-err" />
    <p class="field__hint" id="cf-link-hint">{t.linkHint}</p>
    <p class="field__error" id="cf-link-err" data-error={t.errors.link}></p>
  </div>

  <div class="field field--wide">
    <label for="cf-message">{t.message} <span class="req" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" rows="6" required minlength="10" maxlength="5000" aria-describedby="cf-message-hint cf-message-err"></textarea>
    <p class="field__hint" id="cf-message-hint">{t.messageHint}</p>
    <p class="field__error" id="cf-message-err" data-error={t.errors.message}></p>
  </div>

  {/* Trappola per bot: invisibile alle persone e agli screen reader */}
  <div class="hp" aria-hidden="true">
    <label for="cf-botcheck">Non compilare</label>
    <input id="cf-botcheck" name="botcheck" type="checkbox" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field field--wide field--check">
    <input id="cf-privacy" name="privacy" type="checkbox" required aria-describedby="cf-privacy-err" />
    <label for="cf-privacy">
      {t.privacyBefore}<a href={href('privacy', lang)} target="_blank" rel="noopener">{t.privacyLink}</a>{t.privacyAfter}
      <span class="req" aria-hidden="true">*</span>
    </label>
    <p class="field__error" id="cf-privacy-err" data-error={t.errors.privacy}></p>
  </div>

  <div class="field--wide contact-form__footer">
    <button class="btn" type="submit">{t.send}</button>
    <p class="form-status" role="status" aria-live="polite" data-status></p>
  </div>

  {
    bookingUrl && (
      <p class="field--wide booking" data-booking hidden>
        <a class="btn btn--ghost" href={bookingUrl} target="_blank" rel="noopener" data-booking-link>
          {t.booking}
        </a>
        <span class="booking__note">{t.bookingNote}</span>
      </p>
    )
  }

  <p class="field--wide form-notice">
    {t.notice}<a href={href('privacy', lang)}>{t.noticeLink}</a>.
  </p>
</form>

<style>
  .contact-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
  }

  @media (max-width: 40rem) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field--wide {
    grid-column: 1 / -1;
  }

  .field[hidden] {
    display: none;
  }

  label {
    font-weight: 700;
    font-size: 0.95rem;
  }

  .req {
    color: var(--cyan-300);
  }

  .opt {
    font-weight: 400;
    color: var(--text-muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid rgb(169 196 214 / 0.45);
    border-radius: var(--radius-sm);
    background: var(--bg-deep);
    color: var(--text);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }

  [aria-invalid='true'] {
    border-color: #ff8f8f;
  }

  .field__hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .field__error {
    margin: 0;
    font-size: 0.85rem;
    color: #ffb3b3;
  }

  .field__error:empty {
    display: none;
  }

  .field--check {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.4rem 0.75rem;
  }

  .field--check input {
    width: 1.25rem;
    min-height: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    accent-color: var(--cyan-200);
  }

  .field--check label {
    font-weight: 400;
  }

  .field--check .field__error {
    grid-column: 2;
  }

  .hp {
    display: none;
  }

  .booking {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: 0;
  }

  .booking[hidden] {
    display: none;
  }

  .booking__note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .form-notice {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .form-status {
    margin: 0;
    font-weight: 700;
  }

  .form-status--ok {
    color: var(--green-300);
  }

  .form-status--error {
    color: #ffb3b3;
  }
</style>

<script>
  import { sendContactMessage } from '../lib/form-submit';
  import { track } from '../lib/analytics';

  const BOOKING_AUDIENCES = ['cliente', 'terzista', 'confezionista'];

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.querySelector('[data-booking-link]')?.addEventListener('click', () => track('book_call_click'));
  if (form) {
    const msg = JSON.parse(form.dataset.messages ?? '{}') as Record<string, string> & { topics: Record<string, string> };
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const audience = form.elements.namedItem('audience') as HTMLSelectElement;

    // Preseleziona "Chi sei?" dal link di provenienza (es. ?chi=candidato).
    const preset = new URLSearchParams(location.search).get('chi');
    if (preset && [...audience.options].some((o) => o.value === preset)) audience.value = preset;
    // ...e un messaggio di partenza dal tema scelto (es. ?tema=presentazione), sempre modificabile.
    const topic = msg.topics[new URLSearchParams(location.search).get('tema') ?? ''];
    const messageField = form.elements.namedItem('message') as HTMLTextAreaElement;
    if (topic && !messageField.value) messageField.value = topic;
    // Domanda arrivata dall'assistente delle FAQ (?domanda=...).
    const question = new URLSearchParams(location.search).get('domanda')?.slice(0, 500);
    if (question && !messageField.value) messageField.value = question;

    // Campi e testi che dipendono da "Chi sei?": i campi nascosti sono disattivati, quindi non vengono né controllati né inviati.
    const variants = JSON.parse(form.dataset.variants ?? '{}') as Record<string, Record<string, string>>;
    const company = form.elements.namedItem('company') as HTMLInputElement;
    const applyAudience = () => {
      const who = audience.value;
      form.querySelectorAll<HTMLElement>('[data-for]').forEach((group) => {
        const active = group.dataset.for === who;
        group.hidden = !active;
        group.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input, select').forEach((el) => {
          el.disabled = !active;
        });
      });
      const texts = variants[who] ?? variants.default;
      form.querySelector('[data-link-label]')!.textContent = texts.link;
      form.querySelector('#cf-link-hint')!.textContent = texts.linkHint;
      form.querySelector('#cf-message-hint')!.textContent = texts.messageHint;
      company.required = who === 'fornitore';
      form.querySelector<HTMLElement>('[data-company-required]')!.hidden = !company.required;
      form.querySelector<HTMLElement>('[data-company-optional]')!.hidden = company.required;
    };
    audience.addEventListener('change', applyAudience);
    applyAudience();

    const setStatus = (text: string, kind: 'ok' | 'error' | '' = '') => {
      status.textContent = text;
      status.className = `form-status${kind ? ` form-status--${kind}` : ''}`;
    };

    const fields = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
      'input:not([name="botcheck"]), select, textarea',
    )];

    const validate = (field: (typeof fields)[number]) => {
      if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement) {
        if (field.type !== 'checkbox') field.value = field.value.trim();
      }
      const valid = field.checkValidity();
      const error = form.querySelector<HTMLElement>(`#${field.id}-err`);
      field.setAttribute('aria-invalid', String(!valid));
      if (error) error.textContent = valid ? '' : (error.dataset.error ?? '');
      return valid;
    };

    // Dopo il primo errore, il campo si ricontrolla mentre l'utente lo corregge.
    fields.forEach((field) =>
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') validate(field);
      }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const invalid = fields.filter((f) => !f.disabled && !validate(f));
      if (invalid.length) {
        setStatus(msg.invalid, 'error');
        invalid[0].focus();
        return;
      }

      const data = new FormData(form);
      button.disabled = true;
      setStatus(msg.sending);
      const result = await sendContactMessage({
        name: String(data.get('name')),
        email: String(data.get('email')),
        audience: audience.selectedOptions[0].text,
        company: String(data.get('company') ?? ''),
        link: String(data.get('link') ?? ''),
        message: String(data.get('message')),
        details: {
          'Categoria fornitura': String(data.get('supplierCategory') ?? ''),
          'Zone seguite': String(data.get('agentAreas') ?? ''),
          'Settori e aziende': String(data.get('agentSectors') ?? ''),
          'Mandati attuali': String(data.get('agentMandates') ?? ''),
          'Tipo di progetto': String(data.get('projectType') ?? ''),
          'Scadenza': String(data.get('projectDeadline') ?? ''),
        },
        lang: form.dataset.lang ?? 'it',
        honeypot: data.get('botcheck') !== null,
      });
      button.disabled = false;

      if (result.ok) {
        track('generate_lead', { form: 'contatti', audience: audience.value });
        // Ai potenziali clienti si offre subito la prenotazione di una call.
        const booking = form.querySelector<HTMLElement>('[data-booking]');
        if (booking) booking.hidden = !BOOKING_AUDIENCES.includes(audience.value);
        form.reset();
        applyAudience();
        fields.forEach((f) => f.removeAttribute('aria-invalid'));
        setStatus(msg.ok, 'ok');
      } else {
        setStatus(result.reason === 'not-configured' ? msg.notConfigured : msg.failed, 'error');
      }
    });
  }
</script>
