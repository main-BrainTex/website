---
// Fascia finale di invito al contatto, riusata in più pagine.
interface Props {
  title: string;
  text: string;
  button: string;
  link: string;
}
const { title, text, button, link } = Astro.props;
---

<section class="section cta">
  <div class="wrap cta__inner" data-reveal>
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="actions">
      <a class="btn" href={link}>{button}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background:
      radial-gradient(60rem 30rem at 85% 120%, rgb(48 160 22 / 0.18), transparent 60%),
      radial-gradient(50rem 30rem at 0% 0%, rgb(22 159 204 / 0.2), transparent 60%),
      var(--surface);
    border-top: 1px solid var(--line);
  }

  .cta__inner {
    max-width: 52rem;
    text-align: center;
  }

  .cta__inner .lead {
    margin-inline: auto;
  }

  .cta .actions {
    justify-content: center;
  }
</style>
