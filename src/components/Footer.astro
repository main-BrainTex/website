---
import { formatAddress, SITE } from '../config';
import { href, UI, type Lang, type RouteKey } from '../i18n';
import Logo from './Logo.astro';
import { Image } from 'astro:assets';
import logoFse from '../assets/funders/fse-piemonte.png';
import logoNgeu from '../assets/funders/nextgenerationeu.png';
import logoItaliaDomani from '../assets/funders/italiadomani.png';
import logoMur from '../assets/funders/mur.png';
import logoMics from '../assets/logos/mics.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const f = t.footer;
const links: RouteKey[] = ['solution', 'factory', 'benefits', 'sustainability', 'about', 'careers', 'investors', 'press', 'faq', 'glossary', 'contact'];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo height={34} />
        <p class="muted">
          {f.legalSeat}: {formatAddress(SITE.legalAddress)}<br />
          {f.operationalSeat}: {formatAddress(SITE.operationalAddress)}
        </p>
        <a href={SITE.linkedin} rel="noopener" target="_blank">{f.follow}</a>
      </div>
      <nav aria-label="Footer">
        <ul class="site-footer__links">
          {links.map((key) => <li><a href={href(key, lang)}>{t.nav[key]}</a></li>)}
        </ul>
      </nav>
    </div>

    <section class="site-footer__funding" aria-label={f.funderLogos}>
      <div class="site-footer__funder">
        <div class="site-footer__logos">
          <Image src={logoFse} alt={f.fseLogos} height={32} format="webp" />
        </div>
        <p>{f.fse}</p>
      </div>
      <div class="site-footer__funder">
        <div class="site-footer__logos">
          <Image src={logoNgeu} alt="Finanziato dall'Unione europea – NextGenerationEU" height={36} format="webp" />
          <Image src={logoItaliaDomani} alt="Italiadomani – Piano nazionale di ripresa e resilienza" height={30} densities={[1, 1.5]} format="webp" />
          <Image src={logoMur} alt="Ministero dell'Università e della Ricerca" height={28} format="webp" />
          <Image src={logoMics} alt="MICS – Made in Italy Circolare e Sostenibile" height={30} densities={[1, 2]} format="webp" />
        </div>
        <p>{f.ngeu}</p>
      </div>
    </section>

    <div class="site-footer__legal">
      <p>
        © {year} {SITE.legalName} · {f.taxVat} {SITE.vat} · {f.registry} {SITE.registry} · REA
        {SITE.rea} · {f.capital} {SITE.shareCapital}{SITE.shareCapitalFullyPaid && ` ${f.paidUp}`}
      </p>
      <ul>
        <li><a href={href('privacy', lang)}>{f.privacy}</a></li>
        <li><a href={href('cookies', lang)}>{f.cookies}</a></li>
        <li><button class="linklike" type="button" data-consent-open>{f.cookiePrefs}</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-footer__brand p {
    margin-block: 1rem 0.75rem;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, auto));
    gap: 0.6rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__legal a {
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__links a:hover,
  .site-footer__legal a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__funding {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: 1.5rem 2rem;
    align-items: start;
  }

  .site-footer__funding p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .site-footer__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.1rem;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    background: #fff;
  }

  .site-footer__logos img {
    width: auto;
    max-width: 100%;
    height: auto;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  .linklike {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .linklike:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
