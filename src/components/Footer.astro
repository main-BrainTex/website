---
import { formatAddress, SITE } from '../config';
import { href, UI, type Lang, type RouteKey } from '../i18n';
import LogoPlaceholder from './LogoPlaceholder.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const f = t.footer;
const links: RouteKey[] = ['solution', 'about', 'careers', 'investors', 'press', 'contact'];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <LogoPlaceholder label={t.logoPlaceholder} />
        <p class="muted">
          {f.legalSeat}: {formatAddress(SITE.legalAddress)}<br />
          {f.operationalSeat}: {formatAddress(SITE.operationalAddress)}
        </p>
        <a href={SITE.linkedin} rel="noopener" target="_blank">{f.follow}</a>
      </div>
      <nav aria-label="Footer">
        <ul class="site-footer__links">
          {links.map((key) => <li><a href={href(key, lang)}>{t.nav[key]}</a></li>)}
        </ul>
      </nav>
    </div>

    <section class="site-footer__funding" aria-label={f.funderLogos}>
      <ul class="site-footer__logos">
        <li class="placeholder">Logo FSE+</li>
        <li class="placeholder">Logo Regione</li>
        <li class="placeholder">Logo UE</li>
        <li class="placeholder">Logo NextGenerationEU</li>
      </ul>
      <p>{f.fse}</p>
      <p>{f.ngeu}</p>
    </section>

    <div class="site-footer__legal">
      <p>
        © {year} {SITE.legalName} · {f.taxVat} {SITE.vat} · {f.registry} {SITE.registry} · REA
        {SITE.rea} · {f.capital} {SITE.shareCapital}{SITE.shareCapitalFullyPaid && ` ${f.paidUp}`}
      </p>
      <ul>
        <li><a href={href('privacy', lang)}>{f.privacy}</a></li>
        <li><a href={href('cookies', lang)}>{f.cookies}</a></li>
        <li><button class="linklike" type="button" data-consent-open>{f.cookiePrefs}</button></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    background: var(--bg-deep);
    border-top: 1px solid var(--line);
    font-size: 0.95rem;
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-footer__brand p {
    margin-block: 1rem 0.75rem;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(9rem, auto));
    gap: 0.6rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links a,
  .site-footer__legal a {
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__links a:hover,
  .site-footer__legal a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__funding {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .site-footer__funding p {
    margin-bottom: 0.25rem;
    color: var(--text-muted);
  }

  .site-footer__logos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .site-footer__logos li {
    min-width: 8.5rem;
    min-height: 3rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .site-footer__legal p {
    margin: 0;
  }

  .linklike {
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .linklike:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .site-footer__legal ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
