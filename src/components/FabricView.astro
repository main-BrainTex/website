---
// Illustrazioni disegnate dal codice per "Cosa vedi tu / Cosa vede il sistema / Cosa capisce il sistema":
// lo stesso tratto di tessuto in tre modi. Sono disegni, non foto: si possono sostituire con immagini reali.
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  kind: 'human' | 'system' | 'understood';
}
const { lang, kind } = Astro.props;

const t = {
  it: {
    alt: {
      human: 'Illustrazione: un tratto di tessuto in cui due difetti si notano appena.',
      system: 'Illustrazione: lo stesso tratto analizzato dal sistema, con i due difetti evidenziati da aloni colorati.',
      understood: 'Illustrazione: i due difetti contornati e riconosciuti come filo tirato e macchia.',
    },
    pull: 'Filo tirato',
    stain: 'Macchia',
  },
  en: {
    alt: {
      human: 'Illustration: a stretch of fabric where two defects are barely noticeable.',
      system: 'Illustration: the same stretch analysed by the system, with the two defects highlighted by coloured halos.',
      understood: 'Illustration: the two defects outlined and recognised as a pulled thread and a stain.',
    },
    pull: 'Pulled thread',
    stain: 'Stain',
  },
}[lang];
const id = `fv-${kind}`;
---

<svg class={`fv fv--${kind}`} viewBox="0 0 240 180" role="img" aria-label={t.alt[kind]}>
  <defs>
    <pattern id={`${id}-weave`} width="7" height="7" patternUnits="userSpaceOnUse">
      <rect class="fv__bg" width="7" height="7"></rect>
      <rect class="fv__warp" width="2" height="7"></rect>
      <rect class="fv__weft" width="7" height="3"></rect>
    </pattern>
    <radialGradient id={`${id}-warm`}>
      <stop offset="0" stop-color="#ff8c5a" stop-opacity="0.95"></stop>
      <stop offset="0.45" stop-color="#ffc857" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#ffc857" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id={`${id}-cool`}>
      <stop offset="0" stop-color="#9ced40" stop-opacity="0.9"></stop>
      <stop offset="0.5" stop-color="#35d2f3" stop-opacity="0.45"></stop>
      <stop offset="1" stop-color="#35d2f3" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <rect width="240" height="180" fill={`url(#${id}-weave)`}></rect>

  {
    kind === 'system' && (
      <g>
        <ellipse cx="82" cy="78" rx="26" ry="62" fill={`url(#${id}-warm)`} />
        <ellipse cx="172" cy="118" rx="38" ry="32" fill={`url(#${id}-cool)`} />
        <path class="fv__grid" d="M0 45H240M0 90H240M0 135H240M60 0V180M120 0V180M180 0V180" />
        <line class="fv__scan" x1="0" y1="62" x2="240" y2="62" />
      </g>
    )
  }

  <rect class="fv__pull" x="80.5" y="34" width="3" height="88" rx="1.5"></rect>
  <ellipse class="fv__stain" cx="172" cy="118" rx="13" ry="9"></ellipse>

  {
    kind === 'understood' && (
      <g>
        <rect class="fv__outline fv__outline--alarm" x="72" y="26" width="20" height="104" rx="8" />
        <ellipse class="fv__outline" cx="172" cy="118" rx="21" ry="16" />
        <g transform="translate(98 30)">
          <rect class="fv__tag fv__tag--alarm" width={t.pull.length * 5 + 12} height="16" rx="4" />
          <text class="fv__tag-text" x="6" y="11.5">{t.pull}</text>
        </g>
        <g transform="translate(150 82)">
          <rect class="fv__tag" width={t.stain.length * 5 + 12} height="16" rx="4" />
          <text class="fv__tag-text" x="6" y="11.5">{t.stain}</text>
        </g>
      </g>
    )
  }
</svg>

<style>
  .fv {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
  }

  .fv__bg {
    fill: #0b5a8a;
  }

  .fv__warp {
    fill: rgb(87 240 254 / 0.2);
  }

  .fv__weft {
    fill: rgb(0 33 58 / 0.4);
  }

  .fv--system .fv__bg,
  .fv--understood .fv__bg {
    fill: #06283f;
  }

  .fv--system .fv__warp,
  .fv--understood .fv__warp {
    fill: rgb(87 240 254 / 0.1);
  }

  /* A occhio nudo i difetti si notano appena */
  .fv__pull {
    fill: rgb(190 235 255 / 0.3);
  }

  .fv__stain {
    fill: rgb(0 15 30 / 0.3);
  }

  .fv--system .fv__pull,
  .fv--understood .fv__pull {
    fill: rgb(190 235 255 / 0.9);
  }

  .fv--system .fv__stain,
  .fv--understood .fv__stain {
    fill: rgb(0 10 20 / 0.9);
  }

  .fv__grid {
    fill: none;
    stroke: rgb(87 240 254 / 0.22);
    stroke-width: 0.6;
  }

  .fv__scan {
    stroke: var(--cyan-200);
    stroke-width: 1.4;
  }

  .fv__outline {
    fill: none;
    stroke: var(--green-300);
    stroke-width: 1.8;
  }

  .fv__outline--alarm {
    stroke: #ffc857;
  }

  .fv__tag {
    fill: var(--green-300);
  }

  .fv__tag--alarm {
    fill: #ffc857;
  }

  .fv__tag-text {
    fill: var(--bg-deep);
    font-size: 9.5px;
    font-weight: 700;
  }
</style>
