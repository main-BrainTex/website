---
// Assistente delle domande frequenti, presente in tutte le pagine.
// Gira solo nel browser: cerca tra le FAQ approvate (src/data/faq.ts), nessun servizio esterno, nessuna AI.
// Se la risposta non c'è, porta al modulo di contatto con la domanda già scritta.
import { FAQS } from '../data/faq';
import { href, UI, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  it: {
    open: 'Hai una domanda?',
    title: 'Domande frequenti',
    close: 'Chiudi',
    label: 'Scrivi la tua domanda',
    placeholder: 'Es. quanto costa, su quali macchine…',
    popular: 'Le domande più comuni',
    results: 'Risposte trovate',
    none: 'Non abbiamo ancora una risposta pronta a questa domanda.',
    ask: 'Chiedilo al team',
    all: 'Tutte le domande frequenti',
    note: 'Risposte automatiche dalle domande frequenti. Per tutto il resto ti risponde una persona.',
  },
  en: {
    open: 'Got a question?',
    title: 'FAQ',
    close: 'Close',
    label: 'Type your question',
    placeholder: 'E.g. how much, which machines…',
    popular: 'Most common questions',
    results: 'Answers found',
    none: 'We do not have a ready answer to this question yet.',
    ask: 'Ask the team',
    all: 'All frequently asked questions',
    note: 'Automatic answers from our FAQ. For anything else, a person will reply.',
  },
}[lang];

const POPULAR = ['cosa-fa', 'macchine', 'costo', 'proprieta-dati'];
const data = JSON.stringify({
  faqs: FAQS.map((f) => ({
    id: f.id,
    q: f.q[lang],
    a: f.a[lang],
    keys: f.keys[lang],
    link: f.link ? href(f.link, lang) : '',
    linkLabel: f.link ? (UI[lang].nav as Record<string, string>)[f.link] ?? '' : '',
  })),
  popular: POPULAR,
  contact: href('contact', lang),
  faqPage: href('faq', lang),
});
---

<div class="assistant" data-assistant data-faq={data}>
  <button type="button" class="assistant__open" aria-expanded="false" aria-controls={`assistant-${lang}`} data-assistant-open>
    <span class="assistant__icon" aria-hidden="true">?</span>
    <span>{t.open}</span>
  </button>

  <section class="assistant__panel" id={`assistant-${lang}`} role="dialog" aria-labelledby={`assistant-title-${lang}`} hidden data-assistant-panel>
    <header class="assistant__head">
      <h2 id={`assistant-title-${lang}`}>{t.title}</h2>
      <button type="button" class="assistant__close" aria-label={t.close} data-assistant-close>×</button>
    </header>

    <form class="assistant__search" role="search" data-assistant-form>
      <label class="visually-hidden" for={`assistant-q-${lang}`}>{t.label}</label>
      <input id={`assistant-q-${lang}`} type="search" autocomplete="off" maxlength="200" placeholder={t.placeholder} data-assistant-input />
    </form>

    <div class="assistant__body" aria-live="polite">
      <p class="assistant__label" data-assistant-label data-popular={t.popular} data-results={t.results}>{t.popular}</p>
      <ul class="assistant__list" data-assistant-list></ul>
      <div class="assistant__none" data-assistant-none hidden>
        <p>{t.none}</p>
        <a class="btn" href={href('contact', lang)} data-assistant-ask>{t.ask}</a>
      </div>
    </div>

    <footer class="assistant__foot">
      <a href={href('faq', lang)}>{t.all}</a>
      <a href={href('contact', lang)} data-assistant-ask>{t.ask}</a>
      <p>{t.note}</p>
    </footer>
  </section>
</div>

<style>
  .assistant {
    position: fixed;
    z-index: 50;
    right: 1rem;
    bottom: 1rem;
  }

  .assistant__open {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.5rem 1.1rem 0.5rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 700;
    box-shadow: 0 12px 30px -10px rgb(0 0 0 / 0.6);
    cursor: pointer;
  }

  .assistant__open:hover,
  .assistant__open:focus-visible {
    border-color: var(--accent);
  }

  .assistant__open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .assistant__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--cyan-200);
    color: var(--bg-deep);
  }

  .assistant.is-open .assistant__open {
    display: none;
  }

  .assistant__panel {
    display: flex;
    flex-direction: column;
    width: min(24rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100vh - 2rem));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-deep);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.7);
    overflow: hidden;
  }

  .assistant__panel[hidden] {
    display: none;
  }

  .assistant__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 1rem 0.5rem;
  }

  .assistant__head h2 {
    margin: 0;
    font-size: 1.1rem;
  }

  .assistant__close {
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text);
    font-size: 1.5rem;
    cursor: pointer;
  }

  .assistant__close:hover,
  .assistant__close:focus-visible {
    background: var(--surface);
  }

  .assistant__search {
    padding: 0 1rem 0.75rem;
  }

  .assistant__search input {
    width: 100%;
    min-height: 2.9rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgb(169 196 214 / 0.45);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font: inherit;
  }

  .assistant__search input:focus-visible {
    outline: 2px solid var(--accent);
    border-color: var(--accent);
  }

  .assistant__body {
    flex: 1;
    padding: 0 1rem;
    overflow-y: auto;
  }

  .assistant__label {
    margin: 0 0 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .assistant__list {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .assistant__list :global(details) {
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
  }

  .assistant__list :global(summary) {
    padding: 0.65rem 0.8rem;
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
  }

  .assistant__list :global(summary:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .assistant__list :global(.answer) {
    padding: 0 0.8rem 0.8rem;
    font-size: 0.9rem;
  }

  .assistant__list :global(.answer p) {
    margin: 0 0 0.4rem;
    color: var(--text-muted);
  }

  .assistant__none {
    margin-bottom: 1rem;
  }

  .assistant__none p {
    margin: 0 0 0.75rem;
  }

  .assistant__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.75rem 1rem 0.9rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .assistant__foot a {
    font-weight: 700;
  }

  .assistant__foot p {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media print {
    .assistant {
      display: none;
    }
  }
</style>

<script>
  interface Entry {
    id: string;
    q: string;
    a: string;
    keys: string;
    link: string;
    linkLabel: string;
  }

  // Parole troppo comuni per aiutare la ricerca.
  const STOP = new Set(
    'che chi cosa come con per dei del della delle dal dalla nel nella sul sulla una uno gli le lo la il un di da in su si non anche sono avete fate posso può vostro vostra vostri quanto quanta quanti quale quali dove quando perche the and for are you your with does can how what which who where when why much many from this that have'.split(
      ' ',
    ),
  );
  const words = (text: string) =>
    text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .split(/[^a-z0-9]+/)
      .filter((w) => w.length > 2 && !STOP.has(w));
  // Confronto tollerante: basta la radice comune (es. "costa" trova "costo").
  const near = (a: string, b: string) => {
    if (a === b) return true;
    const n = Math.min(a.length, b.length, 5);
    return n >= 4 && a.slice(0, n) === b.slice(0, n);
  };

  const root = document.querySelector<HTMLElement>('[data-assistant]');
  if (root) {
    const data = JSON.parse(root.dataset.faq ?? '{}') as {
      faqs: Entry[];
      popular: string[];
      contact: string;
      faqPage: string;
    };
    const index = data.faqs.map((f) => ({
      f,
      q: words(f.q),
      keys: words(f.keys),
      a: words(f.a),
    }));
    const openBtn = root.querySelector<HTMLButtonElement>('[data-assistant-open]')!;
    const panel = root.querySelector<HTMLElement>('[data-assistant-panel]')!;
    const input = root.querySelector<HTMLInputElement>('[data-assistant-input]')!;
    const list = root.querySelector<HTMLElement>('[data-assistant-list]')!;
    const label = root.querySelector<HTMLElement>('[data-assistant-label]')!;
    const none = root.querySelector<HTMLElement>('[data-assistant-none]')!;
    const askLinks = [...root.querySelectorAll<HTMLAnchorElement>('[data-assistant-ask]')];

    const search = (text: string) => {
      const terms = words(text);
      if (!terms.length) return null;
      return index
        .map((e) => {
          let score = 0;
          for (const t of terms) {
            if (e.q.some((w) => near(w, t))) score += 3;
            if (e.keys.some((w) => near(w, t))) score += 3;
            if (e.a.some((w) => near(w, t))) score += 1;
          }
          return { f: e.f, score };
        })
        .filter((r) => r.score >= 3)
        .sort((x, y) => y.score - x.score)
        .filter((r, _, all) => r.score * 2 > all[0].score) // solo le risposte vicine alla migliore
        .slice(0, 3)
        .map((r) => r.f);
    };

    const render = (items: Entry[], open: boolean) => {
      list.replaceChildren(
        ...items.map((f, i) => {
          const li = document.createElement('li');
          const details = document.createElement('details');
          details.open = open && i === 0;
          const summary = document.createElement('summary');
          summary.textContent = f.q;
          const answer = document.createElement('div');
          answer.className = 'answer';
          const p = document.createElement('p');
          p.textContent = f.a;
          answer.append(p);
          if (f.link) {
            const a = document.createElement('a');
            a.href = f.link;
            a.textContent = `${f.linkLabel} →`;
            answer.append(a);
          }
          details.append(summary, answer);
          li.append(details);
          return li;
        }),
      );
    };

    // Il link "Chiedilo al team" porta la domanda scritta nel modulo di contatto.
    const updateAsk = () => {
      const q = input.value.trim();
      for (const a of askLinks) a.href = q ? `${data.contact}?domanda=${encodeURIComponent(q)}` : data.contact;
    };

    const update = () => {
      const q = input.value.trim();
      updateAsk();
      const found = search(q);
      if (found === null) {
        label.textContent = label.dataset.popular ?? '';
        label.hidden = false;
        none.hidden = true;
        render(data.popular.map((id) => data.faqs.find((f) => f.id === id)!).filter(Boolean), false);
        return;
      }
      label.textContent = label.dataset.results ?? '';
      label.hidden = found.length === 0;
      none.hidden = found.length > 0;
      render(found, true);
    };

    const open = () => {
      panel.hidden = false;
      root.classList.add('is-open');
      openBtn.setAttribute('aria-expanded', 'true');
      update();
      input.focus();
    };
    const close = () => {
      panel.hidden = true;
      root.classList.remove('is-open');
      openBtn.setAttribute('aria-expanded', 'false');
      openBtn.focus();
    };

    openBtn.addEventListener('click', open);
    root.querySelector('[data-assistant-close]')!.addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
    let timer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(update, 150);
    });
    root.querySelector('[data-assistant-form]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      update();
    });
  }
</script>
