# Copia in .env per lo sviluppo locale (il file .env non va mai committato).
# Percorso base: '/' in produzione, '/website/' per l'anteprima su GitHub Pages.
BASE_PATH=/
# 'production' solo per il sito pubblico; qualsiasi altro valore = anteprima (noindex, niente GA).
DEPLOY_TARGET=preview
# Chiave di accesso Web3Forms legata a account@braintex.it.
PUBLIC_WEB3FORMS_KEY=
